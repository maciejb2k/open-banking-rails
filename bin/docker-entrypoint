#!/bin/bash
# Self-bootstrap entrypoint for production containers.
#
# 1. Reads/generates secrets and persists them in $SECRETS_DIR (mounted as
#    the `app_secrets` named volume). On first boot it generates random
#    values; on every subsequent boot it reads them from the volume.
# 2. Exports those secrets into the process env so Rails initializers see
#    them — the AR encryption initializer otherwise raises in production.
# 3. exec's whatever command was passed (rails server, sidekiq, migrate,
#    a one-off rake task, ...).
#
# Idempotent. Safe to run on every container start. ENV values explicitly
# set by the operator (e.g. SECRET_KEY_BASE in compose) are NEVER
# overwritten — the volume only fills the gaps.

set -e

SECRETS_DIR="${SECRETS_DIR:-/rails/secrets}"
mkdir -p "$SECRETS_DIR"

bootstrap_secret() {
  local file_name=$1
  local var_name=$2
  local file="$SECRETS_DIR/$file_name"

  if [ -n "${!var_name:-}" ]; then
    return 0
  fi

  if [ ! -s "$file" ]; then
    ruby -rsecurerandom -e 'print SecureRandom.hex(32)' > "$file"
    chmod 600 "$file" 2>/dev/null || true
    echo "[entrypoint] generated $file_name"
  fi

  export "$var_name=$(cat "$file")"
}

bootstrap_secret "secret_key_base"                  "SECRET_KEY_BASE"
bootstrap_secret "ar_encryption_primary_key"        "ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY"
bootstrap_secret "ar_encryption_deterministic_key"  "ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY"
bootstrap_secret "ar_encryption_key_derivation_salt" "ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT"

exec "${@}"
