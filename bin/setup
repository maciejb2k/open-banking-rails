#!/usr/bin/env ruby
require "fileutils"
require "securerandom"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# Idempotent .env bootstrap. Self-hosters don't run this script — but for
# the developer cloning the repo to contribute, this saves a manual copy
# and three openssl calls. Keys we already have stay; missing ones get
# generated.
def ensure_env!
  example = File.join(APP_ROOT, ".env.example")
  target  = File.join(APP_ROOT, ".env")

  unless File.exist?(target)
    puts "== Creating .env from .env.example =="
    FileUtils.cp(example, target)
  end

  contents = File.read(target)
  changed = false

  %w[
    ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
    ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
    ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
  ].each do |var|
    next if contents.match?(/^#{var}=.+$/)

    value = SecureRandom.hex(32)
    if contents.match?(/^#{var}=$/)
      contents = contents.sub(/^#{var}=$/, "#{var}=#{value}")
    else
      contents += "\n#{var}=#{value}\n"
    end
    puts "  generated #{var}"
    changed = true
  end

  File.write(target, contents) if changed
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  ensure_env!

  puts "\n== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
