<%= render layout: "admin/settings/preferences/layout", locals: { current: :profile } do %>
  <div class="space-y-6">
    <%= form_with model: @user,
                  url: admin_settings_preferences_profile_path,
                  method: :patch,
                  scope: :user,
                  class: "space-y-6", local: true do |f| %>
      <div class="admin-section space-y-4">
        <h2 class="text-base font-semibold text-foreground">Profile</h2>
        <p class="text-sm text-muted-foreground -mt-2">
          Your display name and the email address tied to this account.
        </p>

        <%= render "admin/shared/form/text_field",
              form: f, field: :name,
              label: "Name",
              placeholder: "Your full name",
              required: true %>

        <%# Email is readonly + not in profile_params strong-params allowlist - Devise treats it as a credential. %>
        <%= render "admin/shared/form/email_field",
              form: f, field: :email,
              label: "Email",
              hint: "Contact support to change this - it's tied to your sign-in.",
              html: {
                readonly: true,
                class: "#{sensitive_class} bg-muted/40 cursor-not-allowed text-muted-foreground"
              } %>
      </div>

      <div class="flex justify-end">
        <%= render "admin/shared/components/button",
              label: "Save profile",
              type: :submit %>
      </div>
    <% end %>

    <%= form_with model: @user,
                  url: admin_settings_preferences_password_path,
                  method: :patch,
                  scope: :user,
                  class: "space-y-6", local: true do |f| %>
      <div class="admin-section space-y-4">
        <h2 class="text-base font-semibold text-foreground">Password</h2>
        <p class="text-sm text-muted-foreground -mt-2">
          Confirm your current password to set a new one. You'll stay signed in
          on this device after the change.
        </p>

        <%= render "admin/shared/form/password_field",
              form: f, field: :current_password,
              label: "Current password",
              required: true %>

        <%= render "admin/shared/form/password_field",
              form: f, field: :password,
              label: "New password",
              required: true %>

        <%= render "admin/shared/form/password_field",
              form: f, field: :password_confirmation,
              label: "Confirm new password",
              required: true %>
      </div>

      <div class="flex justify-end">
        <%= render "admin/shared/components/button",
              label: "Change password",
              type: :submit %>
      </div>
    <% end %>
  </div>
<% end %>
