<div class="space-y-6">
  <%= render "admin/shared/components/page_header",
        title: "Preferences",
        subtitle: "Personal preferences for #{current_user.email}." %>

  <%= form_with model: @user,
                url: admin_settings_preferences_path,
                method: :patch,
                scope: :user,
                class: "space-y-6", local: true do |f| %>

    <div class="admin-section space-y-4">
      <h2 class="text-base font-semibold text-foreground">Profile</h2>
      <p class="text-sm text-muted-foreground -mt-2">
        Your display name. Email (<%= sensitive(current_user.email) %>) is fixed and can't be changed here.
      </p>

      <%= render "admin/shared/form/text_field",
            form: f, field: :name,
            label: "Name",
            placeholder: "Your full name",
            required: true %>
    </div>

    <div class="admin-section space-y-4">
      <h2 class="text-base font-semibold text-foreground">Cash tracking</h2>
      <p class="text-sm text-muted-foreground -mt-2">
        When enabled, every BLIK ATM withdrawal is mirrored as a top-up in
        your cash wallet, and both rows are classified as transfers (excluded
        from spend). You're then expected to log cash spending manually under
        <a href="<%= admin_cash_transactions_path %>" class="text-primary hover:underline">Cash Transactions</a>.
      </p>

      <%= render "admin/shared/form/toggle",
            form: f, field: :track_cash,
            label: "Track cash spending",
            on_label: "Tracking on",
            off_label: "Tracking off",
            hint: "Existing ATM withdrawals stay as-is until you run the backfill task (cash:backfill_atm_links)." %>
    </div>

    <div class="admin-section space-y-4">
      <h2 class="text-base font-semibold text-foreground">Hidden categories</h2>
      <p class="text-sm text-muted-foreground -mt-2">
        Transactions in the selected categories are always masked (••• instead
        of title, merchant, category, and amount). Analytics totals stay
        accurate. Drill-down into these categories / transactions is blocked
        — to open one, remove the category from this list.
      </p>

      <%# Self-cloak: selected categories are masked with bullets in the chip
          itself, so a passerby glancing at this page can't see what you've
          hidden. Once opened, the dropdown shows the full list with search,
          sorted alphabetically — so with 50+ categories you can quickly find
          the right one. %>
      <%= render "admin/shared/form/multi_select",
            form: f, field: :hidden_category_ids,
            label: "Categories to hide",
            placeholder: "Choose categories…",
            cloak_selected: true,
            searchable: true,
            options: current_user.categories.active.includes(:parent).map { |c|
              { value: c.id, label: c.parent ? "#{c.parent.name} → #{c.name}" : c.name }
            }.sort_by { |o| o[:label].downcase } %>
    </div>

    <div class="flex justify-end">
      <%= render "admin/shared/components/button",
            label: "Save preferences",
            type: :submit %>
    </div>
  <% end %>

  <%= form_with model: @user,
                url: update_password_admin_settings_preferences_path,
                method: :patch,
                scope: :user,
                class: "space-y-6", local: true do |f| %>

    <div class="admin-section space-y-4">
      <h2 class="text-base font-semibold text-foreground">Password</h2>
      <p class="text-sm text-muted-foreground -mt-2">
        Confirm your current password to set a new one. You'll stay signed in
        on this device after the change.
      </p>

      <%= render "admin/shared/form/password_field",
            form: f, field: :current_password,
            label: "Current password",
            required: true %>

      <%= render "admin/shared/form/password_field",
            form: f, field: :password,
            label: "New password",
            required: true %>

      <%= render "admin/shared/form/password_field",
            form: f, field: :password_confirmation,
            label: "Confirm new password",
            required: true %>
    </div>

    <div class="flex justify-end">
      <%= render "admin/shared/components/button",
            label: "Change password",
            type: :submit %>
    </div>
  <% end %>
</div>
