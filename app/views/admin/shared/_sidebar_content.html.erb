<%# locals: (nav_sections:) %>
<div class="flex h-full flex-col">
  <div class="flex h-16 items-center border-b border-sidebar-border px-4 group-[.w-16]:px-1.5 group-[.w-16]:justify-center">
    <div class="flex items-center gap-3">
      <div class="h-9 w-9 rounded-lg bg-success text-success-foreground flex items-center justify-center shrink-0">
        <%= render "admin/shared/icons/logo_mark", classes: "h-5 w-5" %>
      </div>
      <span class="text-base font-bold text-sidebar-foreground sidebar-label leading-none">Open Banking<br><span class="text-xs font-normal text-sidebar-muted">Personal finances</span></span>
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto p-3 space-y-6">
    <% nav_sections.each do |section| %>
      <div>
        <h3 class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-sidebar-muted sidebar-label">
          <%= section[:title] %>
        </h3>
        <ul class="space-y-0.5">
          <% section[:items].each do |item| %>
            <%= render "admin/shared/sidebar_item", item: item %>
          <% end %>
        </ul>
      </div>
    <% end %>
  </nav>

  <%# Collapse toggle — desktop only %>
  <div class="hidden lg:block border-t border-sidebar-border p-3">
    <button data-action="click->sidebar#toggleCollapse"
            class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm text-sidebar-foreground/70 hover:bg-sidebar-accent/50 transition-colors">
      <span data-sidebar-target="collapseIconExpanded">
        <%= render "admin/shared/icons/panel_left_close", classes: "h-4 w-4" %>
      </span>
      <span data-sidebar-target="collapseIconCollapsed" class="hidden">
        <%= render "admin/shared/icons/panel_left", classes: "h-4 w-4" %>
      </span>
      <span class="sidebar-label">Collapse</span>
    </button>
  </div>

  <div class="border-t border-sidebar-border p-3">
    <div class="flex items-center gap-3 rounded-lg px-3 py-2 group-[.w-16]:px-0 group-[.w-16]:justify-center">
      <div class="h-8 w-8 rounded-full bg-primary/20 flex items-center justify-center text-primary text-xs font-bold shrink-0 sensitive-avatar">
        <span><%= current_user.initials %></span>
      </div>
      <%= link_to admin_settings_preferences_profile_path,
            class: "flex-1 min-w-0 sidebar-label rounded-md hover:bg-sidebar-accent/40 -mx-1 px-1 py-0.5 transition-colors",
            title: "Profile settings" do %>
        <p class="text-sm font-medium text-sidebar-foreground truncate <%= sensitive_class %>"><%= current_user.display_name %></p>
        <p class="text-xs text-sidebar-muted truncate <%= sensitive_class %>"><%= current_user.email %></p>
      <% end %>
      <%= button_to destroy_user_session_path,
            method: :delete,
            form: { class: "sidebar-label" },
            class: "text-sidebar-muted hover:text-sidebar-foreground transition-colors cursor-pointer",
            title: "Sign out",
            "aria-label": "Sign out" do %>
        <%= render "admin/shared/icons/log_out", classes: "h-4 w-4" %>
      <% end %>
    </div>
  </div>
</div>
