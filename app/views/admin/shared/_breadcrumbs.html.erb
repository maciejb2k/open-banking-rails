<%# locals: (items: []) %>
<% items.each_with_index do |item, i| %>
  <% is_last = i == items.size - 1 %>
  <% sensitive_classes = sensitive_prop(item[:sensitive]) %>
  <span class="flex items-center gap-1">
    <% if is_last %>
      <span class="font-medium text-foreground <%= sensitive_classes %>"><%= item[:label] %></span>
    <% else %>
      <%= link_to item[:label], item[:path], class: "text-muted-foreground hover:text-foreground transition-colors #{sensitive_classes}" %>
      <%= render "admin/shared/icons/chevron_right", classes: "h-3 w-3 text-muted-foreground/50" %>
    <% end %>
  </span>
<% end %>
