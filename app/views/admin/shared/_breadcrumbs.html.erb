<%# locals: (items: []) %>
<%# Mobile collapses to "… › Current" at 3+ levels (… links to immediate parent); sm+ shows the full trail. %>
<% items.each_with_index do |item, i| %>
  <% is_last = i == items.size - 1 %>
  <% sensitive_classes = sensitive_prop(item[:sensitive]) %>
  <% if is_last %>
    <span class="flex items-center gap-1 min-w-0">
      <% if items.size >= 3 %>
        <% parent = items[-2] %>
        <%= link_to parent[:path],
              class: "sm:hidden flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors shrink-0",
              "aria-label": "Back to #{parent[:label]}" do %>
          <span>…</span>
          <%= render "admin/shared/icons/chevron_right", classes: "h-3 w-3 text-muted-foreground/50" %>
        <% end %>
      <% end %>
      <span class="font-medium text-foreground truncate <%= sensitive_classes %>"><%= item[:label] %></span>
    </span>
  <% else %>
    <% mobile_visible = items.size == 2 && i == 0 %>
    <span class="flex items-center gap-1 shrink-0 <%= 'hidden sm:flex' unless mobile_visible %>">
      <%= link_to item[:label], item[:path], class: "text-muted-foreground hover:text-foreground transition-colors whitespace-nowrap #{sensitive_classes}" %>
      <%= render "admin/shared/icons/chevron_right", classes: "h-3 w-3 text-muted-foreground/50" %>
    </span>
  <% end %>
<% end %>
