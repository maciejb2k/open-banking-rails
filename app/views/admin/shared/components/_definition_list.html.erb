<%# locals: (pairs:) %>
<%# Each pair: { label:, value:, mono: false, wrap: false, hint: nil, sensitive: nil }. %>
<%# sensitive: nil/false, true, kind symbol, or hash - see admin/privacy_helper.rb. %>
<dl class="space-y-2 sm:space-y-2 text-sm">
  <% Array(pairs).compact.each do |pair| %>
    <div class="flex flex-col gap-0.5 sm:flex-row sm:justify-between sm:gap-4 py-1 sm:py-0 border-b border-border/40 sm:border-0 last:border-0">
      <dt class="text-muted-foreground shrink-0 text-xs sm:text-sm"><%= pair[:label] %></dt>
      <dd class="text-left sm:text-right min-w-0<%= " font-mono" if pair[:mono] %><%= " break-all" if pair[:wrap] %>">
        <% if pair[:value].present? %>
          <% sensitive_classes = sensitive_prop(pair[:sensitive]) %>
          <% if sensitive_classes %>
            <span class="<%= sensitive_classes %>"><%= pair[:value] %></span>
          <% else %>
            <%= pair[:value] %>
          <% end %>
          <% if pair[:hint].present? %>
            <span class="text-xs text-muted-foreground ml-1"><%= pair[:hint] %></span>
          <% end %>
        <% else %>
          <span class="text-muted-foreground/50">-</span>
        <% end %>
      </dd>
    </div>
  <% end %>
</dl>
