<%# locals: (title:, description:, action_label: nil, action_path: nil, icon: "users") %>
<div class="flex flex-col items-center justify-center py-16 text-center">
  <%= render "admin/shared/icons/#{icon}", classes: "mx-auto h-10 w-10 text-muted-foreground/30 mb-3" %>
  <p class="font-medium text-muted-foreground"><%= title %></p>
  <p class="text-sm text-muted-foreground/70 mt-1"><%= description %></p>
  <% if action_label && action_path %>
    <%= link_to action_path, class: "mt-4 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors" do %>
      <%= render "admin/shared/icons/plus", classes: "h-4 w-4" %>
      <%= action_label %>
    <% end %>
  <% end %>
</div>
