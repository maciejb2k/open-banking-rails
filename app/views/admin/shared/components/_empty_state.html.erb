<%# locals: (title:, description:, action_label: nil, action_path: nil, action_method: :get, icon: "users") %>
<%# `action_method: :post` switches the CTA to button_to (real form, CSRF). %>
<div class="flex flex-col items-center justify-center py-16 text-center">
  <%= render "admin/shared/icons/#{icon}", classes: "mx-auto h-10 w-10 text-muted-foreground/30 mb-3" %>
  <p class="font-medium text-muted-foreground"><%= title %></p>
  <p class="text-sm text-muted-foreground/70 mt-1"><%= description %></p>
  <% if action_label && action_path %>
    <% btn_classes = "mt-4 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors" %>
    <% if action_method.to_sym == :post %>
      <%= button_to action_path, method: :post, class: btn_classes do %>
        <%= render "admin/shared/icons/plus", classes: "h-4 w-4" %>
        <%= action_label %>
      <% end %>
    <% else %>
      <%= link_to action_path, class: btn_classes do %>
        <%= render "admin/shared/icons/plus", classes: "h-4 w-4" %>
        <%= action_label %>
      <% end %>
    <% end %>
  <% end %>
</div>
