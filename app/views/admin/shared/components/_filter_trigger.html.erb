<%# locals: (active_count: 0) %>
<%# Wrap inside data-controller="filter-panel". %>
<button type="button" data-action="filter-panel#open"
        class="inline-flex items-center gap-2 rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-card-hover transition-colors <%= "border-primary/40 text-primary" if active_count > 0 %>">
  <%= render "admin/shared/icons/sliders_horizontal", classes: "h-4 w-4" %>
  Filters
  <% if active_count > 0 %>
    <span class="inline-flex items-center justify-center rounded-full bg-primary px-1.5 min-w-5 h-5 text-xs font-bold text-primary-foreground">
      <%= active_count %>
    </span>
  <% end %>
</button>
