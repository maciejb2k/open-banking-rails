<%# locals: (items:, trigger_label: nil) %>
<div class="relative" data-controller="dropdown">
  <button data-action="click->dropdown#toggle"
          class="rounded-lg p-1 text-muted-foreground hover:bg-card-hover hover:text-foreground transition-colors">
    <% if trigger_label %>
      <%= trigger_label %>
    <% else %>
      <%= render "admin/shared/icons/more_horizontal", classes: "h-4 w-4" %>
    <% end %>
  </button>
  <div data-dropdown-target="menu"
       class="z-50 w-36 rounded-lg border bg-card py-1 shadow-lg hidden">
    <% items.each do |item| %>
      <% if item[:divider] %>
        <div class="my-1 border-t"></div>
      <% elsif item[:method] %>
        <%# Non-GET actions use button_to to ensure correct HTTP method %>
        <%= button_to item[:href],
              method: item[:method],
              form: {data: item[:data] || {}},
              class: "flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-card-hover transition-colors #{item[:variant] == :destructive ? "text-destructive hover:bg-destructive/5" : ""}" do %>
          <% if item[:icon] %>
            <%= render "admin/shared/icons/#{item[:icon]}", classes: "h-3.5 w-3.5" %>
          <% end %>
          <%= item[:label] %>
        <% end %>
      <% elsif item[:href] %>
        <%= link_to item[:href],
              class: "flex items-center gap-2 px-3 py-1.5 text-sm hover:bg-card-hover transition-colors #{item[:variant] == :destructive ? "text-destructive hover:bg-destructive/5" : ""}" do %>
          <% if item[:icon] %>
            <%= render "admin/shared/icons/#{item[:icon]}", classes: "h-3.5 w-3.5" %>
          <% end %>
          <%= item[:label] %>
        <% end %>
      <% else %>
        <button type="button"
                class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-card-hover transition-colors <%= item[:variant] == :destructive ? "text-destructive hover:bg-destructive/5" : "" %>">
          <% if item[:icon] %>
            <%= render "admin/shared/icons/#{item[:icon]}", classes: "h-3.5 w-3.5" %>
          <% end %>
          <%= item[:label] %>
        </button>
      <% end %>
    <% end %>
  </div>
</div>
