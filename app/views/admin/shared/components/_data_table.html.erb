<%# locals: (columns:, rows: nil) %>
<%# Column hash: label:, sortable: ("field" → Ransack sort_link / true → decorative arrow / omit), align: (:right), width: (extra th class). %>
<%# `min-w-[640px]` forces horizontal scroll on mobile instead of column collapse. %>
<div class="overflow-x-auto -mx-px">
  <table class="w-full min-w-[640px] text-sm">
    <thead>
      <tr class="border-b bg-muted/30">
        <% columns.each do |col| %>
          <% align_cls = col[:align] == :right ? "text-right" : "text-left" %>
          <th class="px-3 sm:px-4 py-2.5 sm:py-3 <%= align_cls %> font-medium text-muted-foreground whitespace-nowrap <%= col[:width] %>">
            <% if col[:sortable].is_a?(String) || col[:sortable].is_a?(Symbol) %>
              <%= sort_link col[:label], col[:sortable] %>
            <% elsif col[:sortable] %>
              <button class="flex items-center gap-1 hover:text-foreground transition-colors">
                <%= col[:label] %>
                <%= render "admin/shared/icons/arrow_up_down", classes: "h-3.5 w-3.5 opacity-30" %>
              </button>
            <% else %>
              <%= col[:label] %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= yield if block_given? %>
    </tbody>
  </table>
</div>
