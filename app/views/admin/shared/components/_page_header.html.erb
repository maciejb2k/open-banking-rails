<%# locals: (title:, subtitle: nil, actions: nil, browser_title: nil, back_path: nil, media: nil) %>
<%# Browser <title> defaults to page H1; override via browser_title: when they should differ.
    media: pre-rendered slot (e.g. bank_logo, avatar, icon tile) shown left of the title. %>
<% content_for :title, "#{browser_title || title} · Open Banking" %>
<div class="flex flex-col gap-3 sm:gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex items-start sm:items-center min-w-0 <%= media ? "gap-3 sm:gap-4" : "gap-3" %>">
    <% if back_path %>
      <%= link_to back_path,
            class: "rounded-lg p-2 -ml-1 text-muted-foreground hover:bg-card-hover transition-colors shrink-0" do %>
        <%= render "admin/shared/icons/arrow_left", classes: "h-5 w-5" %>
      <% end %>
    <% end %>
    <% if media %>
      <div class="shrink-0"><%= media %></div>
    <% end %>
    <div class="min-w-0">
      <h1 class="text-xl sm:text-2xl font-bold text-foreground break-words"><%= title %></h1>
      <% if subtitle %>
        <p class="text-xs sm:text-sm text-muted-foreground"><%= subtitle %></p>
      <% end %>
    </div>
  </div>
  <% if actions %>
    <div class="self-start flex flex-wrap items-center gap-2">
      <%= actions %>
    </div>
  <% end %>
</div>
