<%# locals: (title:, subtitle: nil, actions: nil, browser_title: nil, back_path: nil) %>
<%# Browser <title> defaults to page H1; override via browser_title: when they should differ. %>
<% content_for :title, "#{browser_title || title} · Open Banking" %>
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex items-center gap-3">
    <% if back_path %>
      <%= link_to back_path,
            class: "rounded-lg p-2 text-muted-foreground hover:bg-card-hover transition-colors shrink-0" do %>
        <%= render "admin/shared/icons/arrow_left", classes: "h-5 w-5" %>
      <% end %>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-foreground"><%= title %></h1>
      <% if subtitle %>
        <p class="text-sm text-muted-foreground"><%= subtitle %></p>
      <% end %>
    </div>
  </div>
  <% if actions %>
    <div class="self-start flex items-center gap-2">
      <%= actions %>
    </div>
  <% end %>
</div>
