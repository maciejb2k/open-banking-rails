<%# locals: (type: :table) %>
<% if type.to_sym == :table %>
  <div class="admin-section p-0 overflow-hidden animate-pulse">
    <div class="border-b px-4 py-3 bg-muted/30">
      <div class="h-4 w-48 rounded bg-muted"></div>
    </div>
    <% 5.times do %>
      <div class="flex items-center gap-4 border-b px-4 py-3 last:border-0">
        <div class="h-8 w-8 rounded-full bg-muted shrink-0"></div>
        <div class="flex-1 space-y-2">
          <div class="h-3 w-1/3 rounded bg-muted"></div>
          <div class="h-3 w-1/2 rounded bg-muted"></div>
        </div>
        <div class="h-5 w-16 rounded-full bg-muted"></div>
      </div>
    <% end %>
  </div>
<% elsif type.to_sym == :card %>
  <div class="admin-card p-5 animate-pulse space-y-3">
    <div class="h-4 w-24 rounded bg-muted"></div>
    <div class="h-8 w-32 rounded bg-muted"></div>
    <div class="h-3 w-20 rounded bg-muted"></div>
  </div>
<% elsif type.to_sym == :form %>
  <div class="admin-section space-y-5 animate-pulse">
    <% 4.times do %>
      <div class="space-y-1.5">
        <div class="h-3.5 w-24 rounded bg-muted"></div>
        <div class="h-9 w-full rounded-lg bg-muted"></div>
      </div>
    <% end %>
  </div>
<% end %>
