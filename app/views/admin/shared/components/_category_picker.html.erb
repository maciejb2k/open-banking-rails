<%# locals: (form:, field: :category_id, label: "Category", user:, selected: nil, allow_blank: true, blank_label: "-") %>
<%# Full breadcrumb labels disambiguate leaves that repeat across branches; ltree-path order matches tree traversal. %>
<%
  categories = user.categories.active.ordered
  options = categories.map do |c|
    next if defined?(current_user) && current_user && current_user.hides_category?(c)
    indent = "-" * (c.path.to_s.count(".")) # depth-based prefix
    label  = "#{indent} #{c.breadcrumb_names.join(' / ')}".strip
    [ label, c.id ]
  end.compact
%>
<%= form.label field, label, class: "block text-sm font-medium mb-1" %>
<%= form.select field,
      options_for_select(options, selected || form.object.try(field)),
      { include_blank: allow_blank ? blank_label : false },
      class: "form-input" %>
