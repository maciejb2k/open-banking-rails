<%# locals: (filters:, active_filters: []) %>
<div class="admin-section space-y-3" data-controller="filter-bar">
  <div class="flex flex-wrap gap-3">
    <% filters.each do |filter| %>
      <% if filter[:type] == :search %>
        <div class="relative flex-1 min-w-[200px]">
          <%= render "admin/shared/icons/search", classes: "absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" %>
          <input type="text"
                 name="<%= filter[:name] %>"
                 value="<%= filter[:value] %>"
                 placeholder="<%= filter[:placeholder] || "Search..." %>"
                 class="w-full rounded-lg border bg-card pl-9 pr-4 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition">
        </div>
      <% elsif filter[:type] == :select %>
        <select name="<%= filter[:name] %>"
                class="rounded-lg border bg-card px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition">
          <% filter[:options].each do |opt| %>
            <option value="<%= opt[:value] %>" <%= "selected" if opt[:value].to_s == filter[:value].to_s %>><%= opt[:label] %></option>
          <% end %>
        </select>
      <% elsif filter[:type] == :checkbox %>
        <label class="flex items-center gap-2 rounded-lg border bg-card px-3 py-2 text-sm cursor-pointer hover:bg-card-hover transition-colors">
          <input type="checkbox" name="<%= filter[:name] %>" <%= "checked" if filter[:checked] %> class="rounded">
          <span><%= filter[:label] %></span>
        </label>
      <% end %>
    <% end %>
  </div>

  <% if active_filters.any? %>
    <div class="flex flex-wrap items-center gap-2">
      <% active_filters.each do |f| %>
        <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
          <%= f[:label] %>
          <% if f[:remove_path] %>
            <%= link_to f[:remove_path] do %>
              <%= render "admin/shared/icons/x", classes: "h-3 w-3" %>
            <% end %>
          <% end %>
        </span>
      <% end %>
      <button type="button" data-action="click->filter-bar#clearAll"
              class="text-xs text-muted-foreground hover:text-foreground transition-colors">
        Clear all
      </button>
    </div>
  <% end %>
</div>
