<%# locals: (variant: :info, title: nil, message: nil) %>
<%# Flat single-<p> structure mirrors _flash.html.erb for vertical centering - wrapping title+message in a div breaks alignment. %>
<%
  variants = {
    info: "border-info/30 bg-info/10 text-info",
    warning: "border-warning/30 bg-warning/10 text-warning",
    destructive: "border-destructive/30 bg-destructive/10 text-destructive",
    success: "border-success/30 bg-success/10 text-success"
  }
  cls = variants.fetch(variant.to_sym, variants[:info])
  has_body = block_given? || message.present?
%>
<div class="flex items-center gap-3 rounded-xl border px-4 py-3 text-sm <%= cls %>">
  <p>
    <% if title %><span class="font-medium"><%= title %></span><% end %>
    <% if title && has_body %> - <% end %>
    <% if block_given? %><%= yield %><% elsif message %><%= message %><% end %>
  </p>
</div>
