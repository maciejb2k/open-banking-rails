<%# locals: (id:, title:, size: :default) %>
<%
  sizes = {
    sm: "max-w-sm",
    default: "max-w-lg",
    lg: "max-w-2xl",
    xl: "max-w-4xl"
  }
  sz = sizes.fetch(size.to_sym, sizes[:default])
%>
<div id="<%= id %>"
     data-controller="modal"
     class="hidden fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:justify-center p-0 sm:p-4">
  <div class="fixed inset-0 bg-foreground/50" data-action="click->modal#close"></div>
  <%# `max-h` + inner overflow so a tall modal stays usable on phones —
      otherwise the buttons can sit under the on-screen keyboard. %>
  <div class="relative w-full <%= sz %> rounded-t-xl sm:rounded-xl border bg-card shadow-2xl flex flex-col max-h-[92vh] sm:max-h-[90vh]">
    <div class="flex items-center justify-between gap-3 border-b px-4 sm:px-6 py-3 sm:py-4">
      <h2 class="text-base sm:text-lg font-semibold text-foreground truncate"><%= title %></h2>
      <button data-action="click->modal#close"
              class="rounded-lg p-1.5 text-muted-foreground hover:bg-card-hover hover:text-foreground transition-colors shrink-0"
              aria-label="Close">
        <%= render "admin/shared/icons/x", classes: "h-4 w-4" %>
      </button>
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto">
      <%= yield %>
    </div>
  </div>
</div>
