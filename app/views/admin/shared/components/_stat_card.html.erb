<%# locals: (label:, value:, icon:, change: nil, trend: nil, value_class: nil, tone: :primary, hint: nil) %>
<%# `change` + `trend` are optional — omit both for point-in-time stats
    (e.g. balance) where delta-vs-prev doesn't apply. `value_class` lets
    callers wrap sensitive numbers without overriding the layout.
    `tone` differentiates icon-tile color across a stat-card row so the
    eye scans the dashboard faster (each metric kind gets its own hue).
    `hint` is a small line under the value (e.g. previous-period anchor). %>
<%
  tone_classes = {
    primary:     "bg-primary/10 text-primary",
    success:     "bg-success/10 text-success",
    destructive: "bg-destructive/10 text-destructive",
    warning:     "bg-warning/10 text-warning",
    info:        "bg-info/10 text-info",
    muted:       "bg-muted text-muted-foreground"
  }
  tone_cls = tone_classes.fetch(tone.to_sym, tone_classes[:primary])
%>
<div class="admin-card p-5">
  <div class="flex items-center justify-between">
    <div class="rounded-lg p-2 <%= tone_cls %>">
      <%= render "admin/shared/icons/#{icon}", classes: "h-5 w-5" %>
    </div>
    <% if change && trend %>
      <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium <%= trend == :up ? "bg-success/10 text-success" : "bg-destructive/10 text-destructive" %>">
        <% if trend == :up %>
          <%= render "admin/shared/icons/trending_up", classes: "h-3 w-3" %>
        <% else %>
          <%= render "admin/shared/icons/trending_down", classes: "h-3 w-3" %>
        <% end %>
        <%= change.abs %>%
      </span>
    <% end %>
  </div>
  <div class="mt-3">
    <p class="text-2xl font-bold text-foreground tabular-nums truncate <%= value_class %>"><%= value %></p>
    <p class="text-sm text-muted-foreground"><%= label %></p>
    <% if hint %>
      <p class="text-xs text-muted-foreground/70 mt-1 tabular-nums"><%= hint %></p>
    <% end %>
  </div>
</div>
