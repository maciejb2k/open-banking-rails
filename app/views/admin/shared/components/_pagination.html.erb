<%# locals: (pagy:) %>
<% if pagy.pages > 1 %>
  <div class="flex flex-col gap-3 border-t px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
    <span class="text-sm text-muted-foreground">
      Showing <%= pagy.from %>–<%= pagy.to %> of <%= pagy.count %> results
    </span>
    <%== pagy.series_nav %>
  </div>
<% end %>
