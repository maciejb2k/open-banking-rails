<%# locals: (pagy:) %>
<% if pagy.pages > 1 %>
  <div class="flex flex-col gap-3 border-t px-3 sm:px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
    <span class="text-xs sm:text-sm text-muted-foreground">
      Showing <%= pagy.from %>–<%= pagy.to %> of <%= pagy.count %> results
    </span>
    <div class="overflow-x-auto -mx-1 px-1">
      <%== pagy.series_nav %>
    </div>
  </div>
<% end %>
