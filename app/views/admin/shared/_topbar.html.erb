<header class="sticky top-0 z-30 flex h-16 items-center gap-4 border-b bg-card px-4 lg:px-6">
  <%# Mobile menu button %>
  <button data-action="click->sidebar#openMobile"
          class="lg:hidden text-muted-foreground hover:text-foreground transition-colors">
    <%= render "admin/shared/icons/menu", classes: "h-5 w-5" %>
  </button>

  <%# Breadcrumbs %>
  <nav class="flex items-center gap-1 text-sm">
    <%= render "admin/shared/breadcrumbs", items: breadcrumb_items %>
  </nav>

  <%# Right side %>
  <div class="ml-auto flex items-center gap-2">
    <%# Privacy mode toggle — hides sensitive data on screen-share %>
    <%= preference_toggle_button "privacy_mode",
          class_name: "privacy-mode",
          icon_off: "eye",
          icon_on: "eye_off",
          title: "Toggle privacy mode — hides sensitive data on screen-share" %>

    <%# User %>
    <div class="hidden sm:flex items-center gap-2 ml-2 pl-2 border-l">
      <div class="h-8 w-8 rounded-full bg-primary/20 flex items-center justify-center text-primary text-xs font-bold sensitive-avatar">
        <span><%= current_user.initials %></span>
      </div>
      <div class="text-sm">
        <p class="font-medium <%= sensitive_class %>"><%= current_user.display_name %></p>
      </div>
    </div>
  </div>
</header>
