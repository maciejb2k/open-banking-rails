<%# locals: (form:, field:, label: "Password", hint: nil, required: false, html: {}) %>
<% error = form.object.errors[field].first %>
<% html_attrs = html.dup %>
<% extra_class = html_attrs.delete(:class) %>
<% extra_data = html_attrs.delete(:data) || {} %>
<%= render "admin/shared/form/form_group", label: label, hint: hint, error: error, required: required do %>
  <div class="relative" data-controller="toggle">
    <%= form.password_field field, placeholder: "••••••••",
          data: {toggle_target: "field"}.merge(extra_data),
          class: "form-input pr-10 #{error ? "border-destructive focus:ring-destructive/20" : ""} #{extra_class}".strip,
          **html_attrs %>
    <button type="button"
            data-action="click->toggle#switch"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors">
      <span data-toggle-target="show">
        <%= render "admin/shared/icons/eye", classes: "h-4 w-4" %>
      </span>
      <span data-toggle-target="hide" class="hidden">
        <%= render "admin/shared/icons/eye_off", classes: "h-4 w-4" %>
      </span>
    </button>
  </div>
<% end %>
