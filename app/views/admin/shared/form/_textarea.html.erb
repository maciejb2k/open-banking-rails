<%# locals: (form:, field:, label:, placeholder: nil, rows: 4, hint: nil, required: false, value: nil, html: {}) %>
<% error = form.object.errors[field].first %>
<% html_attrs = html.dup %>
<% extra_class = html_attrs.delete(:class) %>
<%= render "admin/shared/form/form_group", label: label, hint: hint, error: error, required: required do %>
  <%= form.text_area field, rows: rows, placeholder: placeholder, value: value,
        class: "form-input resize-y #{error ? "border-destructive focus:ring-destructive/20" : ""} #{extra_class}".strip,
        **html_attrs %>
<% end %>
