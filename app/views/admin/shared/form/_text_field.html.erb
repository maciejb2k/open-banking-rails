<%# locals: (form:, field:, label:, placeholder: nil, hint: nil, required: false, html: {}) %>
<% error = form.object.errors[field].first %>
<% html_attrs = html.dup %>
<% extra_class = html_attrs.delete(:class) %>
<%= render "admin/shared/form/form_group", label: label, hint: hint, error: error, required: required do %>
  <%= form.text_field field, placeholder: placeholder,
        class: "form-input #{error ? "border-destructive focus:ring-destructive/20" : ""} #{extra_class}".strip,
        **html_attrs %>
<% end %>
