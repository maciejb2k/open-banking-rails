          <div class="rounded-lg bg-primary/10 text-primary px-3 py-2 text-sm font-medium">Section A</div>
          <div class="rounded-lg px-3 py-2 text-sm font-medium text-foreground">Section B</div>
          <div class="rounded-lg px-3 py-2 text-sm font-medium text-foreground">Section C</div>
