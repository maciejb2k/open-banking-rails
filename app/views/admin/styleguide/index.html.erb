<div class="space-y-10">
  <%= render "admin/shared/components/page_header",
        title: "Styleguide",
        subtitle: "Component library — all building blocks in one place." %>

  <%# ── BADGES ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Badges</h2>
    <div class="flex flex-wrap gap-2">
      <%= render "admin/shared/components/badge", text: "Default", variant: :default %>
      <%= render "admin/shared/components/badge", text: "Success", variant: :success %>
      <%= render "admin/shared/components/badge", text: "Destructive", variant: :destructive %>
      <%= render "admin/shared/components/badge", text: "Warning", variant: :warning %>
      <%= render "admin/shared/components/badge", text: "Info", variant: :info %>
      <%= render "admin/shared/components/badge", text: "Muted", variant: :muted %>
    </div>
  </section>

  <%# ── BUTTONS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Buttons</h2>
    <div class="flex flex-wrap gap-2">
      <%= render "admin/shared/components/button", label: "Primary", variant: :default %>
      <%= render "admin/shared/components/button", label: "Outline", variant: :outline %>
      <%= render "admin/shared/components/button", label: "Destructive", variant: :destructive %>
      <%= render "admin/shared/components/button", label: "Outline Destructive", variant: :outline_destructive %>
      <%= render "admin/shared/components/button", label: "Ghost", variant: :ghost %>
      <%= render "admin/shared/components/button", label: "With Icon", variant: :default, icon: "plus" %>
      <%= render "admin/shared/components/button", label: "Small", variant: :outline, size: :sm %>
      <%= render "admin/shared/components/button", label: "Large", variant: :default, size: :lg %>
      <%= render "admin/shared/components/button", label: "As Link", variant: :outline, href: "#" %>
    </div>
    <div class="max-w-sm">
      <%= render "admin/shared/components/button", label: "Block (full width)", block: true %>
    </div>
  </section>

  <%# ── PAGE HEADER ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Page Header</h2>
    <div class="space-y-4">
      <%= render "admin/shared/components/page_header", title: "Title only" %>
      <%= render "admin/shared/components/page_header",
            title: "With subtitle",
            subtitle: "A short description of this page." %>
      <%= render "admin/shared/components/page_header",
            title: "With back link",
            subtitle: "back_path: renders an arrow that links to the parent page.",
            back_path: "#" %>
      <%= render "admin/shared/components/page_header",
            title: "With actions",
            subtitle: "Includes action buttons on the right.",
            actions: capture {
              concat render("admin/shared/components/button", label: "Export", variant: :outline, icon: "download")
              concat render("admin/shared/components/button", label: "Add New", variant: :default, icon: "plus")
            } %>
      <%= render "admin/shared/components/page_header",
            title: "With media slot",
            subtitle: "media: accepts any pre-rendered HTML — logo, avatar, icon tile.",
            media: render("admin/shared/components/bank_logo", slug: "mbank", name: "mBank", size: :xl) %>
    </div>
  </section>

  <%# ── STAT CARDS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Stat Cards</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <%= render "admin/shared/components/stat_card", label: "Total Users", value: "1,248", change: 12.5, trend: :up, icon: "users" %>
      <%= render "admin/shared/components/stat_card", label: "Revenue", value: "$48,290", change: 8.2, trend: :up, icon: "dollar_sign" %>
      <%= render "admin/shared/components/stat_card", label: "Orders", value: "356", change: 3.1, trend: :down, icon: "shopping_cart" %>
      <%= render "admin/shared/components/stat_card", label: "Conversion", value: "3.24%", change: 1.8, trend: :up, icon: "bar_chart_3" %>
    </div>
    <p class="text-sm text-muted-foreground pt-2">
      Without delta — for point-in-time stats (balances, counts) where comparison doesn't apply. Omit <code class="bg-muted px-1 rounded text-xs">change</code> and <code class="bg-muted px-1 rounded text-xs">trend</code>.
    </p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <%= render "admin/shared/components/stat_card", label: "Account balance", value: "PLN 12,480.00", icon: "dollar_sign" %>
      <%= render "admin/shared/components/stat_card", label: "Connected banks", value: "3", icon: "package" %>
    </div>
    <p class="text-sm text-muted-foreground pt-2">
      Tones — pass <code class="bg-muted px-1 rounded text-xs">tone:</code> to color-code the icon tile. Helps the eye scan a stat row by category. <code class="bg-muted px-1 rounded text-xs">hint:</code> adds a small caption under the value.
    </p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
      <%= render "admin/shared/components/stat_card", label: "Saldo", value: "12 480 zł", icon: "dollar_sign", tone: :info %>
      <%= render "admin/shared/components/stat_card", label: "Wydatki", value: "3 248 zł", icon: "shopping_cart", tone: :destructive, hint: "30 dni" %>
      <%= render "admin/shared/components/stat_card", label: "Wpływy", value: "5 100 zł", icon: "trending_up", tone: :success, hint: "30 dni" %>
      <%= render "admin/shared/components/stat_card", label: "Top sprzedawca", value: "Biedronka", icon: "tag", tone: :warning, hint: "740 zł · 11 tx" %>
      <%= render "admin/shared/components/stat_card", label: "Δ vs poprz.", value: "+13%", icon: "bar_chart_3", change: 13, trend: :up %>
    </div>
  </section>

  <%# ── CARDS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Cards</h2>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <%= render "admin/shared/components/card", title: "Card with title", subtitle: "Optional subtitle" do %>
        <p class="text-sm text-muted-foreground">Card body content goes here.</p>
      <% end %>
      <% sample_action = capture do %>
        <%= render "admin/shared/components/button", label: "Edit", icon: "pencil", variant: :outline, size: :sm %>
      <% end %>
      <%= render "admin/shared/components/card", title: "Card with actions", subtitle: "Pass `actions:` capture for header buttons.", actions: sample_action do %>
        <p class="text-sm text-muted-foreground">Body content. Action lives in the header next to the title.</p>
      <% end %>
      <%= render "admin/shared/components/card", padding: false do %>
        <div class="p-4 border-b">
          <p class="text-sm font-medium">Card without padding</p>
        </div>
        <div class="p-4">
          <p class="text-sm text-muted-foreground">Used for tables and custom layouts.</p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── EMPTY STATE ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Empty State</h2>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <div class="admin-section">
        <%= render "admin/shared/components/empty_state",
              title: "No users found",
              description: "Try adjusting your filters or add your first user.",
              action_label: "Add User",
              action_path: "#",
              icon: "users" %>
      </div>
      <div class="admin-section">
        <%= render "admin/shared/components/empty_state",
              title: "No results",
              description: "Nothing matches the current filters.",
              icon: "search" %>
      </div>
    </div>
  </section>

  <%# ── TABS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Tabs</h2>
    <div class="admin-section">
      <%= render "admin/shared/components/tabs",
            current: "details",
            tabs: [
              {id: "details", label: "Details", content: capture { concat content_tag(:p, "Details panel content.", class: "text-sm text-muted-foreground") }},
              {id: "activity", label: "Activity", content: capture { concat content_tag(:p, "Activity panel content.", class: "text-sm text-muted-foreground") }},
              {id: "settings", label: "Settings", content: capture { concat content_tag(:p, "Settings panel content.", class: "text-sm text-muted-foreground") }}
            ] %>
    </div>
  </section>

  <%# ── CALLOUT ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Callout</h2>
    <p class="text-sm text-muted-foreground">
      Static, non-dismissible inline alert. Use for context-bound notices inside a page (e.g. validation hints, "this resource is in re-auth mode").
      For top-of-page Rails flash, see <code class="bg-muted px-1 rounded text-xs">admin/shared/_flash.html.erb</code> — auto-dismissible, reads from <code class="bg-muted px-1 rounded text-xs">flash[:notice|:alert|:warning]</code> and is rendered once in the layout.
    </p>
    <%= render "admin/shared/components/callout",
          variant: :info,
          title: "Heads up",
          message: "Re-auth flow: linked accounts will be re-attached to the new connection automatically." %>
    <%= render "admin/shared/components/callout",
          variant: :warning,
          message: "⚠ Your local redirect_url doesn't match anything in the EB allowed list." %>
    <%= render "admin/shared/components/callout",
          variant: :destructive,
          title: "Last verification failed",
          message: "401 Unauthorized — check the application_id and certificate." %>
    <%= render "admin/shared/components/callout",
          variant: :success,
          message: "Connection verified successfully." %>
  </section>

  <%# ── CRITICAL BANNER ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Critical Banner</h2>
    <p class="text-sm text-muted-foreground">
      Top-of-page blocking alert for system states the user must resolve before the rest of the page makes sense (no taxonomy seeded, no LLM provider configured, sync stuck). Loud red by default; warning/info variants exist for less-blocking states. Action button on the right, vertically centered.
      <code class="bg-muted px-1 rounded text-xs">action_method: :post</code> switches to <code class="bg-muted px-1 rounded text-xs">button_to</code> for state-changing CTAs.
      Compare with <strong>Callout</strong> (inline, contextual) and <strong>Empty State</strong> (replaces a missing list).
    </p>
    <%= render "admin/shared/components/critical_banner",
          variant: :destructive,
          title: "Set up your category taxonomy",
          description: "Categories haven't been seeded — the dashboard, matching engine and LLM enrichment have nothing to classify against.",
          action_label: "Load baseline taxonomy",
          action_path: "#",
          action_method: :post,
          icon: "shopping_cart" %>
    <%= render "admin/shared/components/critical_banner",
          variant: :warning,
          title: "LLM provider not configured",
          description: "Set a provider and API key in Preferences before running enrichment.",
          action_label: "Open preferences",
          action_path: "#",
          icon: "settings" %>
    <%= render "admin/shared/components/critical_banner",
          variant: :info,
          title: "Background sync running",
          description: "Latest snapshot is from 2 hours ago. New transactions will appear within minutes.",
          icon: "refresh_cw" %>
  </section>

  <%# ── TOAST ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Toast</h2>
    <p class="text-sm text-muted-foreground">Auto-dismisses after 4 seconds. Slides in from the right.</p>
    <div class="max-w-sm space-y-2">
      <%= render "admin/shared/components/toast", message: "Changes saved successfully.", type: :success %>
      <%= render "admin/shared/components/toast", message: "Failed to delete record.", type: :error %>
      <%= render "admin/shared/components/toast", message: "Session expiring soon.", type: :warning %>
      <%= render "admin/shared/components/toast", message: "New version available.", type: :default %>
    </div>
  </section>

  <%# ── SKELETONS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Skeletons</h2>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <%= render "admin/shared/components/skeleton", type: :card %>
      <%= render "admin/shared/components/skeleton", type: :card %>
      <%= render "admin/shared/components/skeleton", type: :card %>
    </div>
    <%= render "admin/shared/components/skeleton", type: :table %>
  </section>

  <%# ── MODAL ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Modal</h2>
    <div class="flex flex-wrap gap-2">
      <button type="button"
              onclick="document.getElementById('demo-modal-sm').classList.remove('hidden')"
              class="rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-card-hover transition-colors">
        Small
      </button>
      <button type="button"
              onclick="document.getElementById('demo-modal-default').classList.remove('hidden')"
              class="rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-card-hover transition-colors">
        Default
      </button>
      <button type="button"
              onclick="document.getElementById('demo-modal-lg').classList.remove('hidden')"
              class="rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-card-hover transition-colors">
        Large
      </button>
      <button type="button"
              onclick="document.getElementById('demo-modal-xl').classList.remove('hidden')"
              class="rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-card-hover transition-colors">
        Extra Large
      </button>
    </div>
    <%= render "admin/shared/components/modal", id: "demo-modal-sm", title: "Small Modal", size: :sm do %>
      <p class="text-sm text-muted-foreground">A compact modal for short confirmations or simple prompts.</p>
    <% end %>
    <%= render "admin/shared/components/modal", id: "demo-modal-default", title: "Default Modal" do %>
      <p class="text-sm text-muted-foreground">Default size modal. Good for forms and longer content.</p>
    <% end %>
    <%= render "admin/shared/components/modal", id: "demo-modal-lg", title: "Large Modal", size: :lg do %>
      <p class="text-sm text-muted-foreground">Large modal for complex forms or rich content areas.</p>
    <% end %>
    <%= render "admin/shared/components/modal", id: "demo-modal-xl", title: "Extra Large Modal", size: :xl do %>
      <p class="text-sm text-muted-foreground">Extra large modal for data-heavy content or side-by-side layouts.</p>
    <% end %>
  </section>

  <%# ── FILTER TRIGGER + CHIP ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Filter Trigger &amp; Chip</h2>
    <p class="text-sm text-muted-foreground">
      Standalone primitives. <code class="bg-muted px-1 rounded text-xs">filter_trigger</code> opens the slide-out panel and shows the active count badge.
      <code class="bg-muted px-1 rounded text-xs">filter_chip</code> renders an active filter pill with optional remove link.
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <%= render "admin/shared/components/filter_trigger", active_count: 0 %>
      <%= render "admin/shared/components/filter_trigger", active_count: 3 %>
    </div>

    <h3 class="text-sm font-semibold pt-2">Two ways to set chip content</h3>
    <p class="text-xs text-muted-foreground">
      Use <code class="bg-muted px-0.5 rounded">label:</code> keyword for plain strings.
      Use a block when you need custom markup — the canonical case is wrapping
      sensitive values in <code class="bg-muted px-0.5 rounded">sensitive_class</code>
      so they get blurred under privacy mode. Block content also wins if both are passed.
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <%# label: keyword — simplest case %>
      <%= render "admin/shared/components/filter_chip", label: "Status: Active", remove_path: "#" %>
      <%= render "admin/shared/components/filter_chip", label: "Currency: EUR", remove_path: "#" %>
      <%= render "admin/shared/components/filter_chip", label: "Read-only chip" %>

      <%# block — for custom markup like sensitive_class %>
      <%= render "admin/shared/components/filter_chip", remove_path: "#" do %>
        Account: <span class="<%= sensitive_class %>">PL45 1140 …</span>
      <% end %>
      <%= render "admin/shared/components/filter_chip", remove_path: "#" do %>
        Search: "<span class="<%= sensitive_class %>">biedronka</span>"
      <% end %>
    </div>
  </section>

  <%# ── FILTER PANEL ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Filter Panel</h2>
    <p class="text-sm text-muted-foreground">
      Slide-out panel triggered by <code class="bg-muted px-1 rounded text-xs">filter_trigger</code>. Wrap the index content in
      <code class="bg-muted px-1 rounded text-xs">data-controller="filter-panel"</code>.
      The panel must live inside the filter <code class="bg-muted px-1 rounded text-xs">form_with</code> block —
      the Apply button submits the enclosing form. Clear navigates to the base path.
    </p>
    <div data-controller="filter-panel">
      <%= form_with url: "#", method: :get, data: {turbo: false} do |f| %>
        <%# Visible bar — quick search + trigger %>
        <div class="flex items-center gap-3">
          <div class="relative flex-1 max-w-md">
            <%= render "admin/shared/icons/search", classes: "absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" %>
            <input type="text" placeholder="Quick search..." class="form-input pl-9">
          </div>
          <%= render "admin/shared/components/filter_trigger", active_count: 1 %>
        </div>

        <%# Active chip example %>
        <div class="flex flex-wrap items-center gap-2 mt-3">
          <%= render "admin/shared/components/filter_chip", label: "Status: Active", remove_path: "#" %>
          <span class="text-xs text-muted-foreground hover:text-foreground transition-colors cursor-pointer">Clear all</span>
        </div>

        <%# The slide-out panel %>
        <%= render "admin/shared/components/filter_panel", clear_url: "#", active_count: 1 do %>
          <div class="space-y-1.5">
            <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Status</label>
            <select class="form-input">
              <option value="">All statuses</option>
              <option value="active" selected>Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Event</label>
            <select class="form-input">
              <option value="">All events</option>
              <option value="create">Create</option>
              <option value="update">Update</option>
              <option value="destroy">Destroy</option>
            </select>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# ── SORTABLE TABLE HEADERS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Sortable Table Headers</h2>
    <p class="text-sm text-muted-foreground">
      Use <code class="bg-muted px-1 rounded text-xs">sort_link "Label", "column"</code> inside <code class="bg-muted px-1 rounded text-xs">&lt;th&gt;</code>.
      Reads sort state from <code class="bg-muted px-1 rounded text-xs">@q</code> (Ransack object set in controller).
      Active column: <code class="bg-muted px-1 rounded text-xs">text-primary font-medium</code> + directional arrow.
      Inactive columns: faded <code class="bg-muted px-1 rounded text-xs">arrow_up_down</code>.
      Sort param: <code class="bg-muted px-1 rounded text-xs">?q[s]=name+asc</code>.
    </p>
    <div class="admin-section p-0 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b bg-muted/30">
              <th class="px-4 py-3 text-left font-medium text-muted-foreground"><%= sort_link "ID", "id" %></th>
              <th class="px-4 py-3 text-left font-medium text-muted-foreground"><%= sort_link "Name", "name" %></th>
              <th class="px-4 py-3 text-left font-medium text-muted-foreground"><%= sort_link "Created", "created_at" %></th>
            </tr>
          </thead>
          <tbody>
            <% [["1", "Acme Bank", "14 Mar 2026"], ["2", "Globex Bank", "1 Jan 2026"], ["3", "Initech Bank", "5 Feb 2026"]].each do |id, name, date| %>
              <tr class="border-b last:border-0 hover:bg-muted/20 transition-colors">
                <td class="px-4 py-3 text-muted-foreground"><%= id %></td>
                <td class="px-4 py-3 font-medium text-foreground"><%= name %></td>
                <td class="px-4 py-3 text-muted-foreground"><%= date %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%# ── DATA TABLE ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Data Table</h2>
    <div class="admin-section p-0 overflow-hidden">
      <%= render "admin/shared/components/data_table",
            columns: [
              {label: "Name", sortable: true},
              {label: "Status"},
              {label: "Created", sortable: true},
              {label: "Actions"}
            ] do %>
        <% [
          {name: "Acme Bank", status: :success, status_label: "Active", created: "14 Mar 2026"},
          {name: "Globex Bank", status: :muted, status_label: "Inactive", created: "1 Jan 2026"},
          {name: "Initech Bank", status: :muted, status_label: "Inactive", created: "5 Feb 2026"}
        ].each do |row| %>
          <tr class="border-b last:border-0 hover:bg-muted/20 transition-colors">
            <td class="px-4 py-3 font-medium text-foreground"><%= row[:name] %></td>
            <td class="px-4 py-3">
              <%= render "admin/shared/components/badge", text: row[:status_label], variant: row[:status] %>
            </td>
            <td class="px-4 py-3 text-muted-foreground"><%= row[:created] %></td>
            <td class="px-4 py-3">
              <%= render "admin/shared/components/dropdown_menu", items: [
                {label: "View", icon: "eye", href: "#"},
                {label: "Edit", icon: "pencil", href: "#"},
                {divider: true},
                {label: "Delete", icon: "trash_2", variant: :destructive, href: "#", method: :delete}
              ] %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# ── BREAKDOWN LIST ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Breakdown List</h2>
    <p class="text-sm text-muted-foreground">
      Horizontal bar list. Each row: <code class="bg-muted px-1 rounded text-xs">{ label, amount_cents, count, href, secondary }</code>. Bar fill proportional to <code class="bg-muted px-1 rounded text-xs">max_cents</code> (defaults to top row); share % off <code class="bg-muted px-1 rounded text-xs">total_cents</code>. Used by analytics dashboard widgets and drill-downs.
    </p>
    <%
      row_struct = Struct.new(:label, :amount_cents, :count, :href, :secondary, keyword_init: true)
      demo_total = 8_125_29
      demo_rows = [
        row_struct.new(label: "Biedronka",      amount_cents: 2_540_00, count: 11, href: "#"),
        row_struct.new(label: "Lidl",           amount_cents: 1_980_00, count:  8, href: "#"),
        row_struct.new(label: "Allegro",        amount_cents:   980_00, count:  3, href: "#"),
        row_struct.new(label: "Spotify",        amount_cents:   450_00, count:  1, href: "#", secondary: "subskrypcja"),
        row_struct.new(label: "Bez sprzedawcy", amount_cents:   175_00, count:  4)
      ]
    %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <%= render "admin/shared/components/card", title: "With totals + links" do %>
        <%= render "admin/shared/components/breakdown_list", rows: demo_rows, total_cents: demo_total %>
      <% end %>
      <%= render "admin/shared/components/card", title: "Empty state" do %>
        <%= render "admin/shared/components/breakdown_list", rows: [], empty_label: "Brak transakcji w tym okresie" %>
      <% end %>
