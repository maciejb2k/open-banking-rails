  <%# ── BULK ACTION BAR ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Bulk Action Bar</h2>
    <%= render "admin/shared/components/bulk_action_bar",
          count: 3,
          actions: [
            {label: "Export", icon: "download", href: "#"},
            {label: "Delete", icon: "trash_2", variant: :destructive, href: "#"}
          ] %>
  </section>

  <%# ── PAGINATION ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Pagination</h2>
    <p class="text-sm text-muted-foreground">
      Rendered by <code class="bg-muted px-1 rounded text-xs">_pagination.html.erb</code>. Requires <code class="bg-muted px-1 rounded text-xs">@pagy</code> from <code class="bg-muted px-1 rounded text-xs">pagy(:offset, scope)</code> in the controller — pass it as <code class="bg-muted px-1 rounded text-xs">pagy:</code>.
      Live preview is static markup because Pagy's <code class="bg-muted px-1 rounded text-xs">series_nav</code> needs a real request context.
    </p>
    <div class="admin-section">
      <div class="flex flex-col gap-3 border-t px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <span class="text-sm text-muted-foreground">Showing 21–40 of 100 results</span>
        <nav class="flex items-center gap-1 text-sm">
          <a href="#" class="rounded-lg border bg-card px-3 py-1.5 text-muted-foreground hover:bg-card-hover transition-colors">‹</a>
          <a href="#" class="rounded-lg px-3 py-1.5 text-muted-foreground hover:bg-card-hover transition-colors">1</a>
          <span class="rounded-lg bg-primary px-3 py-1.5 text-primary-foreground">2</span>
          <a href="#" class="rounded-lg px-3 py-1.5 text-muted-foreground hover:bg-card-hover transition-colors">3</a>
          <span class="px-2 text-muted-foreground">…</span>
          <a href="#" class="rounded-lg px-3 py-1.5 text-muted-foreground hover:bg-card-hover transition-colors">5</a>
          <a href="#" class="rounded-lg border bg-card px-3 py-1.5 text-muted-foreground hover:bg-card-hover transition-colors">›</a>
        </nav>
      </div>
    </div>
  </section>

  <%# ── DROPDOWN MENU ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Dropdown Menu</h2>
    <div class="admin-section">
      <div class="flex gap-4">
        <%= render "admin/shared/components/dropdown_menu", items: [
          {label: "View", icon: "eye", href: "#"},
          {label: "Edit", icon: "pencil", href: "#"},
          {divider: true},
          {label: "Delete", icon: "trash_2", variant: :destructive}
        ] %>
      </div>
    </div>
  </section>

  <%# ── JSON VIEWER ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">JSON Viewer</h2>
    <div class="admin-section space-y-3">
      <p class="text-sm text-muted-foreground">Drag the bottom-right handle to resize vertically.</p>
      <%= render "admin/shared/components/json_viewer", json: {type: "PaymentInitiation", payment: {amount: "1500.00", currency: "EUR", debtor: {iban: "DE89370400440532013000"}, creditor: {iban: "FR1420041010050500013M02606"}, status: "PENDING"}} %>
    </div>
  </section>

  <%# ── CONFIRM DIALOG ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Confirm Dialog</h2>
    <div class="flex gap-2">
      <button type="button"
              onclick="document.getElementById('demo-confirm-destructive').classList.remove('hidden')"
              class="rounded-lg bg-destructive px-4 py-2 text-sm font-medium text-destructive-foreground hover:bg-destructive/90 transition-colors">
        Destructive
      </button>
      <button type="button"
              onclick="document.getElementById('demo-confirm-default').classList.remove('hidden')"
              class="rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-card-hover transition-colors">
        Default
      </button>
    </div>
    <%= render "admin/shared/components/confirm_dialog",
          id: "demo-confirm-destructive",
          title: "Delete User",
          message: "Are you sure? This action cannot be undone.",
          confirm_label: "Delete",
          variant: :destructive %>
    <%= render "admin/shared/components/confirm_dialog",
          id: "demo-confirm-default",
          title: "Publish Changes",
          message: "This will make the changes visible to all users.",
          confirm_label: "Publish" %>
  </section>

  <%# ── ICONS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Icons</h2>
    <div class="flex flex-wrap gap-4 text-muted-foreground">
      <% %w[layout_dashboard users package shopping_cart bar_chart_3 settings bell shield mail chevron_down chevron_right panel_left_close panel_left log_out menu search trending_up trending_down dollar_sign clock plus arrow_left eye eye_off upload pencil trash_2 more_horizontal arrow_up arrow_down arrow_up_down columns_3 x download tag file_text map sliders_horizontal refresh_cw sparkles].each do |name| %>
        <div class="flex flex-col items-center gap-1 text-xs text-center w-16">
          <%= render "admin/shared/icons/#{name}", classes: "h-5 w-5" %>
          <span class="text-muted-foreground/70 text-[10px] leading-tight"><%= name %></span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── FORM COMPONENTS ── %>
  <%
    demo = StyleguideDemo.new
    demo_with_errors = StyleguideDemo.new
    demo_with_errors.errors.add(:name, "can't be blank")
  %>
  <section class="space-y-5">
    <h2 class="text-lg font-semibold border-b pb-2">Form Components</h2>

    <%# Text inputs %>
    <%= form_with model: demo, url: "#", html: {onsubmit: "return false"} do |f| %>
      <div class="admin-section max-w-2xl space-y-5">
        <h3 class="font-medium">Text Fields</h3>

        <%= render "admin/shared/form/text_field",
              form: f, field: :name,
              label: "Text Field",
              placeholder: "Enter value..." %>

        <%= render "admin/shared/form/text_field",
              form: f, field: :name,
              label: "With hint",
              placeholder: "Enter value...",
              hint: "This is a helpful hint below the input." %>

        <%= render "admin/shared/form/text_field",
              form: f, field: :name,
              label: "Required",
              placeholder: "Enter value...",
              required: true %>

        <%= render "admin/shared/form/email_field",
              form: f, field: :name,
              label: "Email Field",
              placeholder: "user@example.com" %>

        <%= render "admin/shared/form/password_field",
              form: f, field: :name,
              label: "Password Field" %>

        <%= render "admin/shared/form/number_field",
              form: f, field: :name,
              label: "Number Field",
              placeholder: "0", min: 0, max: 100,
              hint: "Enter a value between 0 and 100." %>
      </div>

      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Multi-line & Select</h3>

        <%= render "admin/shared/form/textarea",
              form: f, field: :name,
              label: "Textarea",
              placeholder: "Enter description...",
              rows: 4 %>

        <%= render "admin/shared/form/select",
              form: f, field: :name,
              label: "Select",
              include_blank: "Choose...",
              options: [["Active", "active"], ["Inactive", "inactive"], ["Archived", "archived"]] %>
      </div>

      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Date & Time</h3>

        <%= render "admin/shared/form/date_picker",
              form: f, field: :name,
              label: "Date Picker" %>

        <%= render "admin/shared/form/time_picker",
              form: f, field: :name,
              label: "Time Picker" %>

        <%= render "admin/shared/form/date_range_picker",
              form: f, from_field: :name, to_field: :name,
              label: "Date Range Picker" %>
      </div>

      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Toggles & Selections</h3>

        <%= render "admin/shared/form/checkbox",
              form: f, field: :name,
              label: "Checkbox",
              hint: "Optional hint text." %>

        <%= render "admin/shared/form/toggle",
              form: f, field: :name,
              label: "Toggle Switch",
              on_label: "Active", off_label: "Inactive" %>

        <%= render "admin/shared/form/radio_group",
              form: f, field: :name,
              label: "Radio Group",
              options: [
                {value: "a", label: "Option A"},
                {value: "b", label: "Option B"},
                {value: "c", label: "Option C"}
              ] %>

        <%= render "admin/shared/form/checkbox_group",
              label: "Checkbox Group",
              hint: "Select all that apply.",
              options: [
                {name: "demo_perms[]", value: "read", label: "Read", checked: true},
                {name: "demo_perms[]", value: "write", label: "Write"},
                {name: "demo_perms[]", value: "delete", label: "Delete"}
              ] %>

        <%= render "admin/shared/form/color_picker",
              form: f, field: :name,
              label: "Color Picker" %>
      </div>

      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Advanced Inputs</h3>

        <%= render "admin/shared/form/tags_input",
              form: f, field: :name,
              label: "Tags Input",
              placeholder: "Add a tag and press Enter",
              hint: "Press Enter to add each tag." %>

        <%= render "admin/shared/form/searchable_select",
              form: f, field: :name,
              label: "Searchable Select",
              placeholder: "Search...",
              options: [
                {value: "1", label: "Acme Bank"},
                {value: "2", label: "Globex Bank"},
                {value: "3", label: "Initech Bank"}
              ] %>

        <%= render "admin/shared/form/multi_select",
              form: f, field: :name,
              label: "Multi Select",
              placeholder: "Select options...",
              options: [
                {value: "1", label: "Option A"},
                {value: "2", label: "Option B"},
                {value: "3", label: "Option C"}
              ] %>

        <%= render "admin/shared/form/file_upload",
              form: f, field: :name,
              label: "File Upload",
              accept: "image/*,.pdf",
              hint: "Accepts images and PDFs." %>

      </div>

      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Ajax Select</h3>
        <p class="text-sm text-muted-foreground -mt-2">
          Association picker — searches records via AJAX endpoint, stores ID in hidden field.
          Requires a <code class="bg-muted px-1 rounded text-xs">search</code> collection action returning <code class="bg-muted px-1 rounded text-xs">[{id:, label:}]</code>.
            See docs for full usage. Wpisz cokolwiek — używa lokalnych danych zamiast endpointu.
        </p>
        <%= render "admin/shared/form/ajax_select",
              form: f, field: :name,
              label: "Counterparty",
              search_url: "#",
              hint: "Search by name (min. 3 characters).",
              min_chars: 3,
              mock_options: [
                {id: 1, label: "Acme Bank"},
                {id: 2, label: "Globex Bank"},
                {id: 3, label: "Initech Bank"}
              ] %>
      </div>

      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Category Picker</h3>
        <p class="text-sm text-muted-foreground -mt-2">
          Path-aware category select — depth-prefixed (<code class="bg-muted px-1 rounded text-xs">— —</code>)
          and ordered by ltree path so the visual order matches the tree's
          left-right traversal. Pass the <code class="bg-muted px-1 rounded text-xs">user:</code> whose
          categories should be listed. Used by the manual cash transaction
          form and the classify-transaction modal.
        </p>
        <% if current_user.categories.active.any? %>
          <%= render "admin/shared/components/category_picker",
                form: f, field: :category_id, user: current_user %>
        <% else %>
          <%= render "admin/shared/components/callout",
                variant: :info,
                message: "Seed a taxonomy to preview this component — run the bootstrap on the dashboard." %>
        <% end %>
      </div>

      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Form Group (custom content)</h3>
        <p class="text-sm text-muted-foreground -mt-2">Use when no standard component fits — wraps any content in the standard label/hint/error shell.</p>

        <%= render "admin/shared/form/form_group",
              label: "Custom Field", required: true,
              hint: "Arbitrary content inside the standard label/hint/error wrapper." do %>
          <div class="flex gap-2">
            <input type="text" placeholder="Part one" class="form-input flex-1">
            <input type="text" placeholder="Part two" class="form-input flex-1">
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Error state — separate form with errors %>
    <%= form_with model: demo_with_errors, url: "#", html: {onsubmit: "return false"} do |f| %>
      <div class="admin-section max-w-2xl space-y-5 mt-5">
        <h3 class="font-medium">Error State</h3>

        <%= render "admin/shared/form/error_summary", object: demo_with_errors %>

        <%= render "admin/shared/form/text_field",
              form: f, field: :name,
              label: "Name (with error)",
              placeholder: "Enter name...",
              required: true %>
      </div>
    <% end %>
  </section>

  <%# ── FORM FOOTER ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Form Footer</h2>
    <p class="text-sm text-muted-foreground">
      Action bar used at the bottom of new/edit forms. Compose with the <code class="bg-muted px-1 rounded text-xs">button</code> component:
      Cancel as <code class="bg-muted px-1 rounded text-xs">variant: :outline, href: ...</code>, primary submit as <code class="bg-muted px-1 rounded text-xs">type: :submit</code>.
      Add secondary destructive actions (e.g. Delete) on the left of Cancel using <code class="bg-muted px-1 rounded text-xs">variant: :outline_destructive</code>.
    </p>
    <div class="flex items-center justify-end gap-3">
      <%= render "admin/shared/components/button", label: "Cancel", href: "#", variant: :outline %>
      <%= render "admin/shared/components/button", label: "Save Changes", type: :submit %>
    </div>
    <div class="flex items-center justify-end gap-3">
      <%= render "admin/shared/components/button", label: "Delete", href: "#", method: :delete, variant: :outline_destructive,
            data: { turbo_confirm: "Are you sure?" } %>
      <%= render "admin/shared/components/button", label: "Cancel", href: "#", variant: :outline %>
      <%= render "admin/shared/components/button", label: "Save Changes", type: :submit %>
    </div>
  </section>

  <%# ── ACTION TOOLBAR ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Action Toolbar</h2>
    <p class="text-sm text-muted-foreground">
      Two-slot horizontal toolbar — primary actions on the left, secondary on the right. Both slots accept <code class="bg-muted px-1 rounded text-xs">capture do ... end</code> output.
    </p>
    <%= render "admin/shared/components/action_toolbar",
          left: capture {
            concat render("admin/shared/components/button", label: "Refresh", icon: "refresh_cw", variant: :outline)
            concat render("admin/shared/components/button", label: "Reauth", variant: :default)
            concat render("admin/shared/components/button", label: "Close", variant: :destructive)
          },
          right: capture {
            concat render("admin/shared/components/button", label: "Edit", icon: "pencil", variant: :outline)
          } %>
  </section>

  <%# ── DEFINITION LIST ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Definition List</h2>
    <p class="text-sm text-muted-foreground">
      Label/value pairs for show pages. Each pair: <code class="bg-muted px-1 rounded text-xs">{ label:, value:, mono: false, wrap: false, hint: nil, sensitive: nil }</code>.
      Empty values render as a muted dash. The <code class="bg-muted px-1 rounded text-xs">sensitive:</code> key wires into the privacy-mode helper.
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <%= render "admin/shared/components/card", title: "Identity" do %>
        <%= render "admin/shared/components/definition_list", pairs: [
          { label: "Name", value: "Acme Corp" },
          { label: "Provider", value: "enable_banking", mono: true },
          { label: "Application ID", value: "b67f59d9-4630-4032-bc92-bb7ae9ae91be", mono: true, wrap: true },
          { label: "Empty", value: nil },
          { label: "With hint", value: "180", hint: "(days)" }
        ] %>
      <% end %>
      <%= render "admin/shared/components/card", title: "Compact" do %>
        <%= render "admin/shared/components/definition_list", pairs: [
          { label: "Status", value: "Active" },
          { label: "Created", value: "14 Mar 2026" },
          { label: "By", value: "admin@example.com" }
        ] %>
      <% end %>
    </div>
  </section>

  <%# ── BANK LOGO ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Bank Logo</h2>
    <p class="text-sm text-muted-foreground">
      Square tile keyed by <code class="bg-muted px-1 rounded text-xs">bank_slug</code>. Loads
      <code class="bg-muted px-1 rounded text-xs">app/assets/images/banks/{slug}.svg</code> if present, otherwise renders initials on
      <code class="bg-muted px-1 rounded text-xs">bg-muted</code>. Sizes: <code class="bg-muted px-1 rounded text-xs">:sm :md :lg :xl</code>.
    </p>
    <div class="space-y-4">
      <div class="space-y-2">
        <p class="text-xs text-muted-foreground uppercase tracking-wider">Sizes (mBank)</p>
        <div class="flex items-center gap-3">
          <%= render "admin/shared/components/bank_logo", slug: "mbank", name: "mBank", size: :sm %>
          <%= render "admin/shared/components/bank_logo", slug: "mbank", name: "mBank", size: :md %>
          <%= render "admin/shared/components/bank_logo", slug: "mbank", name: "mBank", size: :lg %>
          <%= render "admin/shared/components/bank_logo", slug: "mbank", name: "mBank", size: :xl %>
        </div>
      </div>
      <div class="space-y-2">
        <p class="text-xs text-muted-foreground uppercase tracking-wider">Supported banks (md)</p>
        <div class="flex items-center gap-3">
          <%= render "admin/shared/components/bank_logo", slug: "mbank", name: "mBank" %>
          <%= render "admin/shared/components/bank_logo", slug: "revolut", name: "Revolut" %>
          <%= render "admin/shared/components/bank_logo", slug: "pko_bank_polski", name: "PKO Bank Polski" %>
        </div>
      </div>
      <div class="space-y-2">
        <p class="text-xs text-muted-foreground uppercase tracking-wider">Fallback (no asset for slug)</p>
        <div class="flex items-center gap-3">
          <%= render "admin/shared/components/bank_logo", slug: "santander", name: "Santander", size: :sm %>
          <%= render "admin/shared/components/bank_logo", slug: "ing_bank_slaski", name: "ING Bank Śląski", size: :md %>
          <%= render "admin/shared/components/bank_logo", slug: "unknown_bank", size: :lg %>
        </div>
      </div>
    </div>
  </section>

  <%# ── BREADCRUMBS ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Breadcrumbs</h2>
    <p class="text-sm text-muted-foreground">
      Navigation trail. Each item: <code class="bg-muted px-1 rounded text-xs">{ label:, path:, sensitive: nil }</code>. The last item renders as plain text (current page).
    </p>
    <div class="flex items-center gap-1 text-sm">
      <%= render "admin/shared/breadcrumbs", items: [
        { label: "Settings", path: "#" },
        { label: "Bank connections", path: "#" },
        { label: "Acme Bank" }
      ] %>
    </div>
  </section>

  <%# ── CATEGORY BREADCRUMB ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Category Breadcrumb</h2>
    <p class="text-sm text-muted-foreground">
      Path-aware label for a category — renders the full ltree path
      ("Lifestyle / Shopping / Electronics") so leaf-only labels stay
      unambiguous when the same name appears under multiple branches.
      Pass <code class="bg-muted px-1 rounded text-xs">link: true</code> to
      make the leaf clickable to its analytics drill-down.
      Hidden categories render as <code class="bg-muted px-1 rounded text-xs">•••</code>
      automatically. Used in the transactions table and analytics views.
    </p>
    <% sample_category = current_user.categories.active.where("nlevel(path) >= 3").first ||
                         current_user.categories.active.where("nlevel(path) >= 2").first ||
                         current_user.categories.active.first %>
    <% if sample_category %>
      <%= render "admin/shared/components/card", title: "Variants" do %>
        <%= render "admin/shared/components/definition_list", pairs: [
          { label: "Default (muted ancestors)",
            value: render("admin/shared/components/category_breadcrumb", category: sample_category) },
          { label: "Linked",
            value: render("admin/shared/components/category_breadcrumb", category: sample_category, link: true) },
          { label: "Plain (muted_ancestors: false)",
            value: render("admin/shared/components/category_breadcrumb", category: sample_category, muted_ancestors: false) },
          { label: "Custom separator",
            value: render("admin/shared/components/category_breadcrumb", category: sample_category, separator: " › ") }
        ] %>
      <% end %>
    <% else %>
      <%= render "admin/shared/components/callout",
            variant: :info,
            message: "Seed a taxonomy to preview this component — run the bootstrap on the dashboard." %>
    <% end %>
  </section>

  <%# ── COMMAND PALETTE ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Command Palette</h2>
    <p class="text-sm text-muted-foreground">
      Global keyboard-triggered search rendered once in the layout (<code class="bg-muted px-1 rounded text-xs">layouts/admin.html.erb</code>). Open with <kbd class="rounded border bg-muted px-1.5 py-0.5 text-xs">Cmd/Ctrl + K</kbd>.
      Items come from <code class="bg-muted px-1 rounded text-xs">admin_nav_sections</code> helper. No extra props — already wired up.
    </p>
  </section>

  <%# ── CENTERED NARROW LAYOUT ── %>
  <section class="space-y-3">
    <h2 class="text-lg font-semibold border-b pb-2">Centered narrow layout</h2>
    <p class="text-sm text-muted-foreground">
      Pages that don't need the full content width — settings, profile screens,
      forms with focused content — use <code class="bg-muted px-1 rounded text-xs">mx-auto max-w-4xl</code>
      on the outer wrapper so the content stays centered on wide displays
      instead of clinging to the left edge. Pair with an in-page side nav
      (<code class="bg-muted px-1 rounded text-xs">grid lg:grid-cols-[220px_minmax(0,1fr)]</code>)
      when sections need to be navigable; the aside collapses to a horizontal
      scroll strip below <code class="bg-muted px-1 rounded text-xs">lg</code>
      so adding more sections doesn't break the layout.
    </p>
    <p class="text-sm text-muted-foreground">
      Live example: <code class="bg-muted px-1 rounded text-xs">app/views/admin/settings/preferences/_layout.html.erb</code>
      — drives <a href="<%= admin_settings_preferences_path %>" class="text-primary hover:underline">/admin/settings/preferences</a>.
      The aside iterates a registry helper (<code class="bg-muted px-1 rounded text-xs">preferences_sections</code>)
      so adding a tab is one entry + one controller action + one view.
    </p>

    <%# Visual demo of the shell — fake aside + main inside the wrapper. %>
    <div class="mx-auto max-w-4xl border-2 border-dashed border-muted-foreground/20 rounded-lg p-3">
