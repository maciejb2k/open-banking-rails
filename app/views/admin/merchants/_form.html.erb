<%# locals: (merchant:) %>
<%= form_with model: merchant, url: merchant.persisted? ? admin_merchant_path(merchant) : admin_merchants_path, html: { class: "space-y-6" } do |f| %>
  <%# `return_to` survives the form submit so the controller can redirect
      back to whatever launched the edit (e.g. AI enrichment review queue)
      instead of the default merchant show page. Sanitized server-side. %>
  <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
  <%= render "admin/shared/form/error_summary", object: merchant %>

  <div class="admin-section max-w-2xl space-y-5">
    <%= render "admin/shared/form/text_field",
          form: f, field: :name,
          label: "Name",
          placeholder: "Biedronka",
          required: true %>

    <% if merchant.persisted? %>
      <%= render "admin/shared/form/text_field",
            form: f, field: :slug,
            label: "Slug",
            hint: "URL identifier — generated automatically, don't change.",
            html: { readonly: true, class: "form-input bg-muted/40 cursor-not-allowed" } %>
    <% end %>

    <%= render "admin/shared/form/searchable_select",
          form: f, field: :default_category_id,
          label: "Default category",
          placeholder: "Type to search categories…",
          options: current_user.categories.active.ordered.map { |c|
            { value: c.id, label: c.breadcrumb_names.join(" / ") }
          } %>

    <%= render "admin/shared/form/select",
          form: f, field: :kind,
          label: "Kind",
          include_blank: "—",
          options: Merchant::KINDS.map { |k| [ k.humanize, k ] } %>

    <%= render "admin/shared/form/text_field",
          form: f, field: :logo_url,
          label: "Logo URL",
          placeholder: "https://..." %>

    <%= render "admin/shared/form/textarea",
          form: f, field: :notes,
          label: "Notes",
          rows: 3 %>
  </div>

  <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-end gap-2 sm:gap-3">
    <% cancel_path = params[:return_to].presence || (merchant.persisted? ? admin_merchant_path(merchant) : admin_merchants_path) %>
    <%= render "admin/shared/components/button", label: "Cancel", href: cancel_path, variant: :outline %>
    <%= render "admin/shared/components/button", label: merchant.persisted? ? "Save changes" : "Create merchant", type: :submit %>
  </div>
<% end %>
