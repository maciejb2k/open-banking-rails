<div class="space-y-6">
  <%= render "admin/shared/components/page_header",
        title: "Matching engine",
        subtitle: "Every transaction flows through this cascade top-to-bottom. The first matching rule wins, the rest are skipped." %>

  <% if current_user.categories.active.empty? %>
    <%# Empty taxonomy — every fallback path lookup fails, so the cascade
        view becomes 23 red "missing category" errors. Short-circuit with
        a single setup CTA. %>
    <%= render "admin/shared/components/empty_state",
          title: "Taxonomy not set up yet",
          description: "Categories haven't been seeded — the matching engine has nothing to map transactions to. Load the baseline taxonomy to get started.",
          action_label: "Load baseline taxonomy",
          action_path: admin_onboarding_seed_taxonomy_path,
          action_method: :post,
          icon: "shopping_cart" %>
  <% else %>
  <%# ── STEP 1: RULES ── %>
  <%= render "admin/shared/components/card", padding: false do %>
    <div class="border-b px-4 py-3">
      <h3 class="font-semibold">1. Match rules (<%= @total_rules_count %>)</h3>
      <p class="text-xs text-muted-foreground">Sorted by: source (user → LLM → system) → priority → id. First match wins. Numbering is global across pages.</p>
    </div>
    <%= render "admin/shared/components/data_table",
          columns: [
            { label: "#", width: "w-12" },
            { label: "Source" },
            { label: "Rule" },
            { label: "Merchant" },
            { label: "Category" },
            { label: "State" },
            { label: "Matches", width: "w-24" }
          ] do %>
      <% @rules.each_with_index do |rule, idx| %>
        <tr class="border-b last:border-0 hover:bg-muted/20 transition-colors <%= 'opacity-50' unless rule.enabled? %>">
          <td class="px-4 py-3 font-mono text-xs text-muted-foreground"><%= @pagy.offset + idx + 1 %></td>
          <td class="px-4 py-3">
            <%= render "admin/shared/components/badge",
                  text: rule.source,
                  variant: { "user" => :default, "llm" => :info, "system" => :muted }[rule.source] || :muted %>
          </td>
          <td class="px-4 py-3 font-mono text-xs break-all">
            <span class="text-muted-foreground"><%= rule.field %></span>
            <span class="text-foreground"><%= rule.kind %></span>
            <span class="text-foreground <%= sensitive_class %>">"<%= rule.pattern %>"</span>
          </td>
          <td class="px-4 py-3 text-sm">
            <% if rule.merchant %>
              <% rm_hidden = hide_private?(rule.merchant.default_category_id) %>
              <span class="<%= sensitive_class unless rm_hidden %>">
                <% if rm_hidden %>
                  <%= hide_private_text(rule.merchant.display, rule.merchant.default_category_id) %>
                <% else %>
                  <%= link_to rule.merchant.display, admin_merchant_path(rule.merchant), class: "hover:underline" %>
                <% end %>
              </span>
            <% else %>
              <span class="text-muted-foreground/50">—</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-xs text-muted-foreground">
            <% if (cat = rule.merchant&.default_category) %>
              <%= render "admin/shared/components/category_breadcrumb", category: cat %>
            <% else %>
              <span class="text-muted-foreground/50">—</span>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <% if rule.enabled? %>
              <%= render "admin/shared/components/badge", text: "enabled", variant: :success %>
            <% else %>
              <%= render "admin/shared/components/badge", text: "disabled", variant: :muted %>
            <% end %>
          </td>
          <td class="px-4 py-3 font-mono text-sm tabular-nums">
            <%= @rule_match_counts[rule.id] || 0 %>
          </td>
        </tr>
      <% end %>
    <% end %>
    <%= render "admin/shared/components/pagination", pagy: @pagy %>
  <% end %>

  <%# ── STEP 2: FALLBACK ── %>
  <%= render "admin/shared/components/card", padding: false do %>
    <div class="border-b px-4 py-3">
      <h3 class="font-semibold">2. Payment-method fallback (<%= @fallback_map.size %>)</h3>
      <p class="text-xs text-muted-foreground">When no rule matches — we look at <code>payment_method</code> and assign a generic category.</p>
    </div>
    <%= render "admin/shared/components/data_table",
          columns: [
            { label: "Direction", width: "w-20" },
            { label: "Payment method" },
            { label: "→ Category" },
            { label: "Kind", width: "w-24" },
            { label: "Matches", width: "w-24" }
          ] do %>
      <% @fallback_map.each do |(direction, payment_method), cat_path| %>
        <% cat = @fallback_categories[cat_path] %>
        <tr class="border-b last:border-0 hover:bg-muted/20 transition-colors">
          <td class="px-4 py-3 text-xs">
            <%= render "admin/shared/components/badge",
                  text: direction,
                  variant: direction == "credit" ? :success : :default %>
          </td>
          <td class="px-4 py-3 font-mono text-xs"><%= payment_method %></td>
          <td class="px-4 py-3 text-sm">
            <% if cat %>
              <%= render "admin/shared/components/category_breadcrumb", category: cat %>
            <% else %>
              <span class="text-destructive">missing category: <%= cat_path %></span>
            <% end %>
          </td>
          <td class="px-4 py-3">
            <% if cat %>
              <%= render "admin/shared/components/badge",
                    text: cat.kind,
                    variant: cat.kind == "ignored" ? :muted : (cat.kind == "income" ? :success : :default) %>
            <% end %>
          </td>
          <td class="px-4 py-3 font-mono text-sm tabular-nums">
            <%= @fallback_counts[[ direction, payment_method ]] || 0 %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>

  <%# ── SUMMARY ── %>
  <%= render "admin/shared/components/card", title: "Summary" do %>
    <%= render "admin/shared/components/definition_list", pairs: [
      { label: "All transactions",        value: @total_count, mono: true },
      { label: "Classified by rule",      value: @total_rule_matches, mono: true },
      { label: "Classified by fallback",  value: @fallback_counts.values.sum, mono: true },
      { label: "Unmatched",               value: @unmatched_count, mono: true }
    ] %>
  <% end %>
  <% end %>
</div>
