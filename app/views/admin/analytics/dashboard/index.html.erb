<%
  user_accounts = current_user.bank_accounts.to_a + current_user.cash_wallets.to_a

  spend_total     = Money.new(@spend_cents,           @filter.currency)
  income_total    = Money.new(@income_cents,          @filter.currency)
  net_total       = Money.new(@net_cents,             @filter.currency)
  avg_daily_spend = Money.new(@avg_daily_spend_cents, @filter.currency)

  # MTD: "5 days of May" reads better than "5 days"; for everything else
  # the bare count is what the user picked and is unambiguous.
  period_hint = if @filter.month_to_date?
                  "#{pluralize(@filter.period.length_days, 'day')} of #{Date.current.strftime('%b')}"
                else
                  pluralize(@filter.period.length_days, "day")
                end
  bucket_label = { day: "day", week: "week", month: "month" }.fetch(@filter.bucket)
  bucket_unit  = bucket_label.capitalize
  date_fmt     = case @filter.bucket
                 when :day   then "%-d %b"
                 when :week  then "%-d %b"
                 when :month then "%b %y"
                 end

  # Chart palette — picked once so every widget sits in the same visual
  # family.
  current_color = "rgb(99, 102, 241)"   # indigo-500
  positive_fill = "rgba(16, 185, 129, 0.75)"  # emerald
  negative_fill = "rgba(239, 68, 68, 0.75)"   # red
  positive_border = "rgb(16, 185, 129)"
  negative_border = "rgb(239, 68, 68)"
  donut_palette = [
    "rgb(99, 102, 241)",   # indigo
    "rgb(14, 165, 233)",   # sky
    "rgb(245, 158, 11)",   # amber
    "rgb(16, 185, 129)",   # emerald
    "rgb(139, 92, 246)",   # violet
    "rgb(239, 68, 68)",    # red
    "rgb(100, 116, 139)"   # slate
  ]

  # ── Spend by category — Chart.js horizontal bar. Δ vs prev. lands in
  # the tooltip via `metadata` (count + delta), and the "Top movers" row
  # surfaces the biggest swings explicitly — so we deliberately avoid
  # painting +/-% labels on the bars themselves (datalabels at variable
  # bar-end positions look messy and steal focus from magnitude).
  # Tail past 12 collapsed into one "Other" (no delta — different
  # aggregation level).
  visible    = @breakdown.first(20)
  rest       = @breakdown.drop(20)
  rest_total = rest.sum(&:amount_cents)

  # Path-based rows: each row has `path` (ltree string), `name` (rendered),
  # `slug` (URL key), `amount_cents`, `prev_amount_cents`. The bar chart
  # labels by name, drills by slug. Hiding a path subtree hides every
  # row whose path starts with that prefix — covered by hide_private?
  # (User#hides_category? walks the subtree).
  hidden_for_row = ->(row) {
    cat = current_user.categories.find_by(path: row.path)
    cat && current_user.hides_category?(cat)
  }
  category_labels = visible.map { |r| hidden_for_row.call(r) ? "•••" : r.name }
  category_values = visible.map { |r| (r.amount_cents / 100.0).round(2) }
  category_metadata = visible.map { |r| { count: r.count, delta: r.delta_pct }.compact }
  category_urls   = visible.map { |r|
    next nil if hidden_for_row.call(r)
    r.slug ? admin_analytics_category_path(r.slug, @filter.to_query_params) : nil
  }

  if rest.any?
    category_labels << "Other (#{rest.size})"
    category_values << (rest_total / 100.0).round(2)
    category_metadata << {}
    category_urls   << nil
  end

  category_chart_config = {
    type: "bar",
    data: {
      labels: category_labels,
      datasets: [{
        data: category_values,
        backgroundColor: current_color,
        borderRadius: 4,
        barThickness: 18
      }]
    },
    options: {
      currency: @filter.currency,
      indexAxis: "y",
      responsive: true,
      maintainAspectRatio: false,
      metadata: category_metadata,
      plugins: {
        legend: { display: false },
        datalabels: { display: false }
      },
      scales: {
        x: {
          grid: { color: "rgba(148,163,184,0.15)" },
          ticks: { tickFormat: "money", font: { size: 11 } },
          beginAtZero: true
        },
        y: {
          grid: { display: false },
          ticks: { font: { size: 11 }, autoSkip: false }
        }
      }
    }
  }
  category_chart_height = (category_labels.size * 32) + 40

  # ── Cash flow timeline — paired bars per bucket: income (green up)
  # next to spend (red up). Y axis stays positive; net is in the caption
  # above so users still get the single-number takeaway. Bucket comes
  # from the granularity chip selection (D/W/M).
  cf_labels        = @cash_flow.map { |p| p.date.strftime(date_fmt) }
  cf_income_values = @cash_flow.map { |p| (p.income_cents / 100.0).round(2) }
  cf_spend_values  = @cash_flow.map { |p| (p.spend_cents / 100.0).round(2) }

  cash_flow_config = {
    type: "bar",
    data: {
      labels: cf_labels,
      datasets: [
        {
          label: "Income",
          data: cf_income_values,
          backgroundColor: positive_fill,
          borderColor: positive_border,
          borderWidth: 1,
          borderRadius: 2
        },
        {
          label: "Spend",
          data: cf_spend_values,
          backgroundColor: negative_fill,
          borderColor: negative_border,
          borderWidth: 1,
          borderRadius: 2
        }
      ]
    },
    options: {
      currency: @filter.currency,
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: true, position: "top", align: "end",
          labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, pointStyle: "circle", font: { size: 10 }, padding: 8 }
        },
        datalabels: { display: false }
      },
      scales: {
        x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkip: true, autoSkipPadding: 14, font: { size: 10 } } },
        y: {
          grid: { color: "rgba(148,163,184,0.15)" },
          ticks: { tickFormat: "money", font: { size: 11 } },
          beginAtZero: true
        }
      }
    }
  }

  # ── Account breakdown donut.
  acct_total_cents = @account_rows.sum(&:amount_cents)
  acct_total       = Money.new(acct_total_cents, @filter.currency)
  acct_labels = @account_rows.map do |r|
    bank = r.account.current_bank_connection&.bank_name || r.account.current_bank_connection&.bank_slug
    [bank, r.account.display_name].compact_blank.join(" — ")
  end
  acct_values = @account_rows.map { |r| (r.amount_cents / 100.0).round(2) }
  acct_colors = donut_palette.first(@account_rows.size).then { |p| p.size < @account_rows.size ? p + Array.new(@account_rows.size - p.size, "rgb(100, 116, 139)") : p }
  acct_urls   = @account_rows.map { |r| admin_analytics_root_path(@filter.to_query_params.merge(account_ids: [r.account.id])) }

  donut_config = {
    type: "doughnut",
    data: {
      labels: acct_labels,
      datasets: [{
        data: acct_values,
        backgroundColor: acct_colors,
        borderWidth: 2,
        borderColor: "#ffffff",
        hoverOffset: 8
      }]
    },
    options: {
      currency: @filter.currency,
      cutout: "65%",
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: "right", align: "center",
          labels: { padding: 10, usePointStyle: true, pointStyle: "circle", font: { size: 11 }, boxWidth: 8, boxHeight: 8 }
        },
        datalabels: { display: false }
      }
    }
  }

  # ── Top merchants — Chart.js horizontal bar, basic.
  # Merchants whose default category is hidden render as bullets — the
  # merchant name itself is the giveaway ("Caritas Poland" → Pomoc).
  merchant_labels = @top_merchants.map { |r|
    hide_private?(r.merchant.default_category_id) ? "•••" : r.merchant.display
  }
  merchant_values = @top_merchants.map { |r| (r.amount_cents / 100.0).round(2) }
  merchant_counts = @top_merchants.map(&:count)
  merchant_urls   = @top_merchants.map { |r|
    next nil if hide_private?(r.merchant.default_category_id)
    admin_analytics_merchant_path(r.merchant.slug, @filter.to_query_params)
  }

  merchants_chart_config = {
    type: "bar",
    data: {
      labels: merchant_labels,
      datasets: [{
        data: merchant_values,
        backgroundColor: current_color,
        borderRadius: 4,
        barThickness: 18
      }]
    },
    options: {
      currency: @filter.currency,
      indexAxis: "y",
      responsive: true,
      maintainAspectRatio: false,
      metadata: merchant_counts.map { |c| { count: c } },
      plugins: {
        legend: { display: false },
        datalabels: { display: false }
      },
      scales: {
        x: {
          grid: { color: "rgba(148,163,184,0.15)" },
          ticks: { tickFormat: "money", font: { size: 11 } },
          beginAtZero: true
        },
        y: {
          grid: { display: false },
          ticks: { font: { size: 11 }, autoSkip: false }
        }
      }
    }
  }
  merchants_chart_height = (merchant_labels.size * 32) + 40
  merchant_labels_present = @top_merchants.any?
  category_labels_present = category_labels.any?
%>

<div class="space-y-6">
  <%= render "admin/shared/components/page_header",
        title: "Analytics",
        subtitle: "Where your money goes — one filter, every view." %>

  <% if @drill_category %>
    <%# Active subtree narrow — surface it so the user can back out. The
        only path here today is the "Spend by domain" chart bars; once a
        second drill entry-point appears, lift this into a proper
        breadcrumb component. %>
    <div class="flex items-center gap-2 text-sm -mt-2">
      <span class="text-muted-foreground">Drilled into:</span>
      <span class="font-medium text-foreground <%= sensitive_class %>"><%= @drill_category.name %></span>
      <%= link_to url_for(@filter.to_query_params.except(:under_path)),
            class: "text-xs text-muted-foreground hover:text-foreground transition-colors" do %>
        × Clear
      <% end %>
    </div>
  <% end %>

  <%= render "admin/analytics/shared/filter_strip", filter: @filter, user_accounts: user_accounts %>

  <%# ── Unmatched-debits banner ──
      Persistent CTA when the current view has uncategorised debits
      (effective_category_id IS NULL). Those debits don't appear in
      any total below — without surfacing them the dashboard silently
      under-reports spend. Hidden when the queue is empty. %>
  <% if @unmatched_count.positive? %>
    <%
      unmatched_amount = Money.new(@unmatched_amount_cents, @filter.currency)
      unmatched_share  = @unmatched_share_pct.positive? ? " · #{@unmatched_share_pct}% of detected spend" : ""
      unmatched_desc   = "#{unmatched_amount.format(no_cents_if_whole: true)}#{unmatched_share} — these don't appear in totals below until classified."
    %>
    <%= render "admin/shared/components/critical_banner",
          variant:      :warning,
          icon:         "shopping_cart",
          title:        "#{pluralize(@unmatched_count, 'transaction')} awaiting classification",
          description:  unmatched_desc,
          action_label: "Classify now",
          action_path:  admin_llm_enrichments_path %>
  <% end %>

  <%# ── Stat cards row — 5 metrics, color-coded tones ── %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
    <%= render "admin/shared/components/stat_card",
          label: "Spend",
          value: spend_total.format(no_cents_if_whole: true),
          icon: "shopping_cart", tone: :destructive,
          hint: period_hint,
          value_class: sensitive_class %>
    <%# Card #2 swaps shape based on filter mode:
        — MTD with ≥3 days elapsed: run-rate (projected EOM spend, with
          delta vs previous full month)
        — MTD on day 1–2 OR rolling N-day window: avg daily spend %>
    <% if @run_rate_cents %>
      <%
        run_rate_total      = Money.new(@run_rate_cents, @filter.currency)
        prev_full_month     = @prev_full_month_spend_cents ? Money.new(@prev_full_month_spend_cents, @filter.currency) : nil
        run_rate_delta_pct  = if @prev_full_month_spend_cents&.positive?
                                (((@run_rate_cents - @prev_full_month_spend_cents).to_f / @prev_full_month_spend_cents) * 100).round
                              end
        run_rate_tone       = run_rate_delta_pct.nil? ? :info :
                              (run_rate_delta_pct > 5 ? :destructive :
                              (run_rate_delta_pct < -5 ? :success : :info))
        run_rate_hint       = prev_full_month ? "vs #{prev_full_month.format(no_cents_if_whole: true)} last month" : "projected end of month"
      %>
      <%= render "admin/shared/components/stat_card",
            label: "Run-rate",
            value: run_rate_total.format(no_cents_if_whole: true),
            icon: "trending_up", tone: run_rate_tone,
            hint: run_rate_hint,
            value_class: sensitive_class %>
    <% else %>
      <%= render "admin/shared/components/stat_card",
            label: "Avg daily spend",
            value: avg_daily_spend.format(no_cents_if_whole: true),
            icon: "trending_down", tone: :info,
            hint: "per day · #{pluralize(@filter.account_ids.size, "account")}",
            value_class: sensitive_class %>
    <% end %>
    <% if @spend_delta_pct.nil? %>
      <%= render "admin/shared/components/stat_card",
            label: "Δ vs prev.",
            value: "—",
            icon: "bar_chart_3",
            hint: "no prior data",
            value_class: sensitive_class %>
    <% else %>
      <%= render "admin/shared/components/stat_card",
            label: "Δ vs prev.",
            value: "#{@spend_delta_pct.positive? ? '+' : ''}#{@spend_delta_pct}%",
            change: @spend_delta_pct,
            trend:  @spend_delta_pct >= 0 ? :up : :down,
            icon:   "bar_chart_3",
            hint:   @filter.previous_label,
            value_class: sensitive_class %>
    <% end %>
    <%= render "admin/shared/components/stat_card",
          label: "Income",
          value: income_total.format(no_cents_if_whole: true),
          icon: "trending_up", tone: :success,
          hint: "net #{@net_cents >= 0 ? '+' : ''}#{net_total.format(no_cents_if_whole: true)}",
          value_class: sensitive_class %>
    <% if @savings_rate_pct.nil? %>
      <%= render "admin/shared/components/stat_card",
            label: "Savings rate",
            value: "—",
            icon: "trending_up", tone: :muted,
            hint: "no income in period",
            value_class: sensitive_class %>
    <% else %>
      <%# Savings rate = (income − spend) / income. The KPI of personal
          finance — what % of what came in stayed in. Negative = overspent
          (red). %>
      <%= render "admin/shared/components/stat_card",
            label: "Savings rate",
            value: "#{@savings_rate_pct}%",
            icon: "trending_up",
            tone: @savings_rate_pct >= 0 ? :success : :destructive,
            hint: @savings_rate_pct >= 0 ? "of income kept" : "spent more than earned",
            value_class: sensitive_class %>
    <% end %>
  </div>

  <%# ── Layer 2 facets row — needs vs wants, recurring vs one-off ── %>
  <%# Custom: paired stacked bars + share %. Each Pair has left/right
      with amounts. If a 3rd two-axis facet shows up, extract _facet_pair. %>
  <% if @spend_cents.positive? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% [
           [ "Essentials vs discretionary", @essential_pair, "of spend covers needs", :success, :info ],
           [ "Recurring vs one-off",         @recurring_pair, "of spend repeats every cycle", :info, :muted ]
         ].each do |title, pair, hint_suffix, left_tone, right_tone| %>
        <%= render "admin/shared/components/card", title: title, subtitle: "#{pair.left_share_pct}% #{hint_suffix}" do %>
          <div class="flex h-3 rounded-full overflow-hidden bg-muted">
            <div class="bg-primary" style="width: <%= pair.left_share_pct %>%"></div>
            <div class="bg-muted-foreground/30" style="width: <%= pair.right_share_pct %>%"></div>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3 text-sm">
            <div>
              <div class="text-xs text-muted-foreground"><%= pair.left.label %></div>
              <div class="font-bold tabular-nums <%= sensitive_class %>"><%= pair.left.amount.format(no_cents_if_whole: true) %></div>
              <div class="text-xs text-muted-foreground"><%= pair.left_share_pct %>% · <%= pluralize(pair.left.count, "tx") %></div>
            </div>
            <div>
              <div class="text-xs text-muted-foreground"><%= pair.right.label %></div>
              <div class="font-bold tabular-nums <%= sensitive_class %>"><%= pair.right.amount.format(no_cents_if_whole: true) %></div>
              <div class="text-xs text-muted-foreground"><%= pair.right_share_pct %>% · <%= pluralize(pair.right.count, "tx") %></div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# ── Row 1: spend-by-category (rich bar) + cash-flow timeline ── %>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <div class="lg:col-span-7">
      <%= render "admin/shared/components/card",
            title: "Spend by category",
            subtitle: safe_join([
              "total ",
              sensitive(spend_total.format(no_cents_if_whole: true)),
              " · #{visible.size}#{rest.any? ? " + tail (#{rest.size})" : ""} · hover for Δ vs prev."
            ]) do %>
        <% if category_labels_present %>
          <div data-controller="chart"
               data-chart-config-value="<%= category_chart_config.to_json %>"
               data-chart-urls-value="<%= category_urls.to_json %>"
               style="height: <%= category_chart_height %>px">
            <canvas></canvas>
          </div>
        <% else %>
          <%# Distinguish three different "empty" states. Showing the same
              "No spend in selected period" message for all of them is
              misleading when raw debits exist — the user thinks the data
              is missing. %>
          <%
            raw_debit_count = @filter.scope.debits.count
            no_categories   = current_user.categories.active.empty?
          %>
          <% if no_categories %>
            <%= render "admin/shared/components/empty_state",
                  title: "Taxonomy not set up",
                  description: "Categories haven't been seeded — analytics needs them to classify transactions. Use the banner above to load the baseline.",
                  icon: "shopping_cart" %>
          <% elsif raw_debit_count.positive? %>
            <%= render "admin/shared/components/empty_state",
                  title: "#{raw_debit_count} transactions awaiting classification",
                  description: "Raw debits exist in the period but none have been mapped to a category yet. Run AI enrichment or classify them manually.",
                  action_label: "Run AI enrichment",
                  action_path: admin_llm_enrichments_path,
                  icon: "shopping_cart" %>
          <% else %>
            <%= render "admin/shared/components/empty_state",
                  title: "No spend",
                  description: "No spending in the selected period/accounts.",
                  icon: "shopping_cart" %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="lg:col-span-5">
      <%= render "admin/shared/components/card",
            title: "Cash flow",
            subtitle: "income vs spend · per #{bucket_label} · #{period_hint}" do %>
        <% if @cash_flow.all?(&:quiet?) %>
          <%= render "admin/shared/components/empty_state",
                title: "All quiet",
                description: "No transaction in the selected period changed the balance.",
                icon:  "bar_chart_3" %>
        <% else %>
          <%# Custom: two-up summary above the chart (Net flow / Biggest bucket).
              Tied to this widget's specific signals; if a 2nd chart needs the
              same shape, extract `_chart_caption` taking [{label, value, tone}]. %>
          <% biggest = @cash_flow.max_by { |p| p.net_cents.abs } %>
          <div class="flex items-baseline justify-between gap-3 mb-3 px-1">
            <div>
              <p class="text-xs text-muted-foreground">Net flow</p>
              <p class="amount text-lg <%= @net_cents >= 0 ? 'text-success' : 'text-destructive' %> <%= sensitive_class %>">
                <%= @net_cents >= 0 ? "+" : "" %><%= net_total.format(no_cents_if_whole: true) %>
              </p>
            </div>
            <% if biggest && !biggest.quiet? %>
              <div class="text-right">
                <p class="text-xs text-muted-foreground">Biggest <%= bucket_label %></p>
                <p class="amount text-sm <%= sensitive_class %>">
                  <%= biggest.net_cents >= 0 ? "+" : "" %><%= biggest.amount.format(no_cents_if_whole: true) %>
                  <span class="text-muted-foreground text-xs font-normal">· <%= biggest.date.strftime(date_fmt) %></span>
                </p>
              </div>
            <% end %>
          </div>
          <div data-controller="chart"
               data-chart-config-value="<%= cash_flow_config.to_json %>"
               style="height: 240px">
            <canvas></canvas>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── Row 2: top movers (5-up cards) ── %>
  <%# Custom: per-mover card with directional tint and conditional drill
      link. No equivalent shared component — stat_card is single-metric,
      this row is comparative. If a 2nd "comparative card row" appears
      (e.g. categories under-budget), extract `_movers_grid`. %>
  <% if @top_movers.any? %>
    <%= render "admin/shared/components/card",
          title: "Top movers",
          subtitle: "biggest swings · #{@filter.previous_label}" do %>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <% @top_movers.each do |mover| %>
          <%
            mover_cat = current_user.categories.find_by(path: mover.path)
            cat_hidden = mover_cat && current_user.hides_category?(mover_cat)
            href = (mover.slug && !cat_hidden) ? admin_analytics_category_path(mover.slug, @filter.to_query_params) : nil
            tint = mover.direction == :up ? "bg-destructive/5 border-destructive/20" : "bg-success/5 border-success/20"
            delta_tone = mover.direction == :up ? "text-destructive" : "text-success"
            base_cls = "block rounded-lg border p-4 transition-colors #{tint} #{href ? 'hover:bg-muted/50 cursor-pointer' : ''}"
            wrapper_attrs = { class: base_cls }
            wrapper_attrs[:href] = href if href
            wrapper_tag = href ? :a : :div
          %>
          <%= content_tag(wrapper_tag, wrapper_attrs) do %>
            <div class="flex items-baseline justify-between gap-2">
              <p class="text-sm font-semibold truncate <%= sensitive_class %>"><%= cat_hidden ? "•••" : mover.name %></p>
              <% if mover.new_spend? %>
                <%= render "admin/shared/components/badge", text: "new", variant: :info %>
              <% elsif mover.delta_pct %>
                <span class="text-xs font-bold tabular-nums <%= delta_tone %>"><%= mover.delta_pct.positive? ? "+" : "" %><%= mover.delta_pct %>%</span>
              <% end %>
            </div>
            <p class="text-base font-bold tabular-nums mt-2 <%= sensitive_class %>">
              <%= mover.current_amount.format(no_cents_if_whole: true) %>
            </p>
            <p class="text-xs text-muted-foreground mt-0.5 <%= sensitive_class %>">
              <% if mover.new_spend? %>
                new this period
              <% else %>
                <%= mover.direction == :up ? "+" : "−" %><%= mover.delta_amount.format(no_cents_if_whole: true) %> vs prev
              <% end %>
            </p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# ── Row 3: top merchants list + accounts donut ── %>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <div class="lg:col-span-7">
      <%= render "admin/shared/components/card",
            title: "Top merchants",
            subtitle: "click → transactions" do %>
        <% if merchant_labels_present %>
          <div data-controller="chart"
               data-chart-config-value="<%= merchants_chart_config.to_json %>"
               data-chart-urls-value="<%= merchant_urls.to_json %>"
               style="height: <%= merchants_chart_height %>px">
            <canvas></canvas>
          </div>
        <% else %>
          <%= render "admin/shared/components/empty_state",
                title: "No merchants",
                description: "No merchants matched in this period.",
                icon: "tag" %>
        <% end %>
      <% end %>
    </div>

    <div class="lg:col-span-5">
      <%= render "admin/shared/components/card",
            title: "Accounts — share of spend",
            subtitle: "click → filter to this account" do %>
        <% if @account_rows.empty? %>
          <%= render "admin/shared/components/empty_state",
                title: "No data",
                description: "No spend on any of the selected accounts.",
                icon: "package" %>
        <% else %>
          <%# Custom: donut + center "Total X PLN". No equivalent shared
              component. Trigger extraction once a 2nd donut appears. %>
          <div class="relative" style="height: 260px">
            <div data-controller="chart"
                 data-chart-config-value="<%= donut_config.to_json %>"
                 data-chart-urls-value="<%= acct_urls.to_json %>"
                 class="absolute inset-0">
              <canvas></canvas>
            </div>
            <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none"
                 style="left: 0; right: 50%">
              <p class="text-xs text-muted-foreground">Total</p>
              <p class="text-lg font-bold text-foreground <%= sensitive_class %>">
                <%= acct_total.format(no_cents_if_whole: true) %>
              </p>
              <p class="text-xs text-muted-foreground"><%= pluralize(@account_rows.size, "account") %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── Layer-1 rollup — top-level domains (or one level under current drill).
      Click on a bar narrows the whole dashboard via ?under_path; the
      detailed leaf chart in Row 1 stays in sync because it shares the
      same scope. ── %>
  <% if @domain_breakdown.any? %>
    <%
      domain_visible    = @domain_breakdown.first(10)
      domain_labels     = domain_visible.map { |r| hidden_for_row.call(r) ? "•••" : r.name }
      domain_values     = domain_visible.map { |r| (r.amount_cents / 100.0).round(2) }
      domain_metadata   = domain_visible.map { |r| { count: r.count, delta: r.delta_pct }.compact }
      domain_urls       = domain_visible.map { |r|
        next nil if hidden_for_row.call(r)
        url_for(@filter.to_query_params.merge(under_path: r.path))
      }

      domain_chart_config = {
        type: "bar",
        data: {
          labels: domain_labels,
          datasets: [ {
            data: domain_values,
            backgroundColor: current_color,
            borderRadius: 4,
            barThickness: 22
          } ]
        },
        options: {
          currency: @filter.currency,
          indexAxis: "y",
          responsive: true,
          maintainAspectRatio: false,
          metadata: domain_metadata,
          plugins: {
            legend: { display: false },
            datalabels: { display: false }
          },
          scales: {
            x: {
              grid: { color: "rgba(148,163,184,0.15)" },
              ticks: { tickFormat: "money", font: { size: 11 } },
              beginAtZero: true
            },
            y: {
              grid: { display: false },
              ticks: { font: { size: 12 }, autoSkip: false }
            }
          }
        }
      }
      domain_chart_height = (domain_labels.size * 36) + 40

      domain_card_title    = @drill_category ? "Spend in #{@drill_category.name}" : "Spend by domain"
      domain_card_subtitle = "click a bar to narrow the dashboard to that area"
    %>
    <%= render "admin/shared/components/card",
          title:    domain_card_title,
          subtitle: domain_card_subtitle do %>
      <div data-controller="chart"
           data-chart-config-value="<%= domain_chart_config.to_json %>"
           data-chart-urls-value="<%= domain_urls.to_json %>"
           style="height: <%= domain_chart_height %>px">
        <canvas></canvas>
      </div>
    <% end %>
  <% end %>

  <%# ── Row 5: biggest single transactions ── %>
  <% if @top_transactions.any? %>
    <%
      all_transactions_url = admin_bank_transactions_path(q: {
        booking_date_gteq: @filter.period.from.iso8601,
        booking_date_lteq: @filter.period.to.iso8601,
        direction_eq: "debit",
        s: "amount_cents desc"
      })
      biggest_actions = capture do %>
        <%= render "admin/shared/components/button",
              label: "See all",
              href: all_transactions_url,
              variant: :outline,
              size: :sm %>
    <% end %>
    <%= render "admin/shared/components/card",
          title: "Biggest transactions",
          subtitle: "top #{@top_transactions.size} · #{pluralize(@filter.period.length_days, 'day')} window",
          actions: biggest_actions do %>
      <%= render "admin/shared/components/data_table",
            columns: [
              { label: "Date",             width: "w-28" },
              { label: "Merchant / title" },
              { label: "Category" },
              { label: "Account" },
              { label: "Amount",           align: :right }
            ] do %>
        <% @top_transactions.each do |tx| %>
          <%# Privacy gating — when the transaction's effective category
              is on the user's hidden list, both the label (merchant /
              title) and the category cell render as bullets so the row
              still shows up in totals but reveals nothing. The amount,
              date and account stay visible since they don't leak the
              nature of the spend. %>
          <% private_row = hide_private?(tx.effective_category_id) %>
          <% raw_label   = tx.merchant&.display.presence || tx.title.presence || tx.counterparty_name.presence || "—" %>
          <% label       = private_row ? "•••" : raw_label %>
          <% category    = tx.effective_category %>
          <tr class="border-b last:border-0 hover:bg-muted/20 transition-colors cursor-pointer"
              onclick="window.location='<%= ledger_entry_path(tx) %>'">
            <td class="px-4 py-3 font-mono text-xs whitespace-nowrap text-muted-foreground">
              <%= tx.booking_date.strftime("%-d %b %Y") %>
            </td>
            <td class="px-4 py-3 max-w-xs truncate">
              <span class="<%= sensitive_class %>"><%= label %></span>
            </td>
            <td class="px-4 py-3 text-xs">
              <% if private_row %>
                <span class="text-muted-foreground">•••</span>
              <% elsif category %>
                <span class="text-muted-foreground <%= sensitive_class %>"><%= category.name %></span>
              <% else %>
                <span class="text-muted-foreground/60 italic">uncategorised</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-muted-foreground <%= sensitive_class %>">
              <%= tx.bank_account.display_name %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <span class="font-semibold tabular-nums <%= sensitive_class %>">
                <%= Money.new(tx.amount_cents, tx.currency).format(no_cents_if_whole: false, symbol: false) %>
              </span>
              <span class="text-muted-foreground text-xs ml-1"><%= tx.currency %></span>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
