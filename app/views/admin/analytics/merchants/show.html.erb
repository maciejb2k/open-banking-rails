<%
  user_accounts = current_user.bank_accounts.to_a + current_user.cash_wallets.to_a
  total = Money.new(@total_cents, @filter.currency)

  trend_labels = @monthly_trend.map { |b| b[:bucket].strftime("%b %y") }
  trend_values = @monthly_trend.map { |b| (b[:value].to_i / 100.0).round(2) }
  trend_config = {
    type: "bar",
    data: {
      labels: trend_labels,
      datasets: [{
        label: "Spend (#{@filter.currency})",
        data: trend_values,
        backgroundColor: "rgb(99, 102, 241)",
        borderRadius: 4
      }]
    },
    options: {
      currency: @filter.currency,
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, ticks: { tickFormat: "money" } }
      }
    }
  }
%>

<div class="space-y-6">
  <%= render "admin/shared/components/page_header",
        title: @merchant.display,
        subtitle: "#{pluralize(@filter.period.length_days, 'day')} · #{pluralize(@count, 'transaction')}" %>

  <%= render "admin/analytics/shared/filter_strip", filter: @filter, user_accounts: user_accounts %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <%= render "admin/shared/components/stat_card",
          label: "Total in period",
          value: total.format(no_cents_if_whole: false),
          icon:  "shopping_cart",
          tone:  :destructive,
          value_class: sensitive_class %>
    <%= render "admin/shared/components/stat_card",
          label: "Transactions",
          value: @count.to_s,
          icon:  "tag",
          tone:  :warning %>
    <% if @merchant.default_category %>
      <%= render "admin/shared/components/stat_card",
            label: "Default category",
            value: @merchant.default_category.name,
            icon:  "shopping_cart",
            tone:  :muted %>
    <% end %>
  </div>

  <%= render "admin/shared/components/card", title: "Monthly trend — 12 months" do %>
    <% if trend_values.sum.zero? %>
      <%= render "admin/shared/components/empty_state",
            title: "No transactions",
            description: "No activity at this merchant in the last year.",
            icon: "bar_chart_3" %>
    <% else %>
      <div data-controller="chart"
           data-chart-config-value="<%= trend_config.to_json %>"
           style="height: 220px">
        <canvas></canvas>
      </div>
    <% end %>
  <% end %>

  <%= render "admin/shared/components/card", padding: false do %>
    <div class="border-b px-4 py-3">
      <h3 class="font-semibold">Transactions</h3>
      <p class="text-xs text-muted-foreground"><%= @count %> total · sorted by date desc</p>
    </div>
    <% if @transactions.empty? %>
      <%= render "admin/shared/components/empty_state",
            title: "No transactions",
            description: "No transactions at this merchant in the selected period.",
            icon: "search" %>
    <% else %>
      <%# Full-row clickable list — same pattern as llm_enrichments/index
          "What's left" rows. <tr> can't host an <a>, so we use <ul>/<li>. %>
      <ul class="divide-y">
        <% @transactions.each do |tx| %>
          <%# Dispatch by source_type to avoid N+1 from LedgerEntry#source_record. %>
          <% detail_path = case tx.source_type
                           when "BankTransaction"   then admin_bank_transaction_path(tx.source_id)
                           when "ManualTransaction" then edit_admin_cash_transaction_path(tx.source_id)
                           end %>
          <% bc = tx.bank_account.current_bank_connection %>
          <% bank_label = bc&.bank_name.presence || bc&.bank_slug %>
          <% row_inner = capture do %>
            <div class="flex items-center gap-4 px-4 py-3 <%= "hover:bg-muted/20 transition-colors" if detail_path %>">
              <div class="font-mono text-xs text-muted-foreground whitespace-nowrap w-24 shrink-0">
                <%= tx.booking_date %>
              </div>
              <div class="min-w-0 flex-1">
                <div class="text-sm truncate <%= sensitive_class %>">
                  <%= tx.title.presence || tx.counterparty_name.presence || "—" %>
                </div>
                <div class="flex items-center gap-1.5 mt-0.5 min-w-0">
                  <% if bc %>
                    <%= render "admin/shared/components/bank_logo",
                          slug: bc.bank_slug, name: bc.bank_name, size: :sm %>
                    <span class="text-xs text-muted-foreground truncate"><%= bank_label %></span>
                    <span class="text-xs text-muted-foreground/50">·</span>
                  <% end %>
                  <span class="text-xs text-muted-foreground truncate <%= sensitive_class %>">
                    <%= tx.bank_account.display_name %>
                  </span>
                  <% if tx.bank_account.iban.present? %>
                    <span class="text-xs text-muted-foreground/50">·</span>
                    <span class="text-xs font-mono text-muted-foreground/70 truncate <%= sensitive_class %>">
                      <%= tx.bank_account.iban %>
                    </span>
                  <% end %>
                </div>
              </div>
              <div class="amount text-sm whitespace-nowrap text-right shrink-0">
                <span class="<%= sensitive_class %>"><%= tx.amount.format(no_cents_if_whole: false) %></span>
                <span class="text-muted-foreground text-xs font-normal"><%= tx.currency %></span>
              </div>
              <% if detail_path %>
                <%= render "admin/shared/icons/chevron_right", classes: "h-4 w-4 text-muted-foreground shrink-0" %>
              <% end %>
            </div>
          <% end %>
          <li>
            <% if detail_path %>
              <%= link_to detail_path, class: "block" do %><%= row_inner %><% end %>
            <% else %>
              <%= row_inner %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= render "admin/shared/components/pagination", pagy: @pagy %>
    <% end %>
  <% end %>
</div>
