<%# locals: (filter:, user_accounts:, wrap_controller: true, with_trigger: true) %>
<%# wrap_controller: false → caller already provides data-controller="filter-panel". with_trigger: false → caller renders the Filters trigger elsewhere (e.g. page_header actions). %>

<%
  day_presets = [
    { label: "Today", days: 1   },
    { label: "3d",    days: 3   },
    { label: "7d",    days: 7   },
    { label: "14d",   days: 14  },
    { label: "30d",   days: 30  },
    { label: "60d",   days: 60  },
    { label: "90d",   days: 90  },
    { label: "180d",  days: 180 },
    { label: "365d",  days: 365 }
  ]
  active_preset_days = day_presets.find { |p| p[:days] == filter.period.length_days }&.dig(:days)

  today_d  = Date.current
  bom      = today_d.beginning_of_month
  prev_bom = (today_d << 1).beginning_of_month
  prev_eom = (today_d << 1).end_of_month

  month_presets = [
    {
      label:  "This month",
      from:   bom,
      to:     today_d,
      active: filter.month_to_date?
    },
    {
      label:  "Last month",
      from:   prev_bom,
      to:     prev_eom,
      active: filter.period.from == prev_bom && filter.period.to == prev_eom
    },
    {
      label:  "Last 3M",
      from:   (today_d << 3).beginning_of_month,
      to:     (today_d << 1).end_of_month,
      active: filter.period.from == (today_d << 3).beginning_of_month && filter.period.to == prev_eom
    },
    {
      label:  "Last 6M",
      from:   (today_d << 6).beginning_of_month,
      to:     (today_d << 1).end_of_month,
      active: filter.period.from == (today_d << 6).beginning_of_month && filter.period.to == prev_eom
    },
    {
      label:  "Last 12M",
      from:   (today_d << 12).beginning_of_month,
      to:     (today_d << 1).end_of_month,
      active: filter.period.from == (today_d << 12).beginning_of_month && filter.period.to == prev_eom
    }
  ]
  any_month_active = month_presets.any? { |p| p[:active] }

  # Three URL states: default (all-owned → no params), explicit zero (?accounts=none), or narrowed (?account_ids[]=…).
  owned_ids   = current_user.all_bank_account_ids
  current_ids = filter.account_ids

  account_chip_links = user_accounts.map do |acc|
    is_active = current_ids.include?(acc.id)
    new_ids =
      if filter.all_accounts?
        owned_ids - [acc.id]
      elsif is_active
        current_ids - [acc.id]
      else
        current_ids + [acc.id]
      end

    base = filter.to_query_params.except(:account_ids, :accounts)
    href =
      if new_ids.sort == owned_ids.sort
        url_for(base)
      elsif new_ids.empty?
        url_for(base.merge(accounts: "none"))
      else
        url_for(base.merge(account_ids: new_ids))
      end

    { account: acc, active: is_active, href: href }
  end

  active_count = filter.all_accounts? ? 0 : filter.account_ids.size

  # Soft primary tint+ring on active - fully-filled fill would obliterate the bank logo.
  active_chip_cls   = "bg-primary/10 ring-1 ring-primary/40 text-foreground"
  inactive_chip_cls = "border border-border/70 bg-card text-muted-foreground hover:text-foreground hover:bg-muted/40"
%>

<%= tag.div(class: "space-y-3", **(wrap_controller ? { data: { controller: "filter-panel" } } : {})) do %>
  <%= form_with url: url_for(only_path: true), method: :get, html: { data: { turbo: false } } do |f| %>

    <%# Period chips strip ?bucket so the smart default re-resolves; an explicit Granularity chip below overrides until the period changes again. %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-full sm:w-20 shrink-0">Months</span>
      <div class="flex flex-wrap items-center gap-1.5 flex-1 min-w-0">
        <% month_presets.each do |preset| %>
          <% href = url_for(filter.to_query_params.except(:bucket).merge(from: preset[:from].iso8601, to: preset[:to].iso8601)) %>
          <% cls = "rounded-full px-3 sm:px-3.5 py-1.5 text-xs font-medium transition-colors #{preset[:active] ? active_chip_cls : inactive_chip_cls}" %>
          <%= link_to preset[:label], href, class: cls %>
        <% end %>
      </div>
      <span class="text-xs text-muted-foreground tabular-nums shrink-0 order-last sm:order-none w-full sm:w-auto">
        <%= filter.period.from.strftime("%-d %b") %> → <%= filter.period.to.strftime("%-d %b %Y") %>
      </span>
      <% if with_trigger %>
        <%= render "admin/shared/components/filter_trigger", active_count: active_count %>
      <% end %>
    </div>

    <%# Rolling-window comparisons go to Period#previous; month-aligned ones go to Filter#previous_range. %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1.5 mt-1.5 border-t border-border/40">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-full sm:w-20 shrink-0">Days</span>
      <div class="flex flex-wrap items-center gap-1.5 flex-1 min-w-0">
        <% day_presets.each do |preset| %>
          <% to = Date.current %>
          <% from = to - (preset[:days] - 1).days %>
          <% href = url_for(filter.to_query_params.except(:bucket).merge(from: from.iso8601, to: to.iso8601)) %>
          <% is_active = !any_month_active && active_preset_days == preset[:days] %>
          <% cls = "rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors #{is_active ? active_chip_cls : inactive_chip_cls}" %>
          <%= link_to preset[:label], href, class: cls %>
        <% end %>
      </div>
    </div>

    <%# bucket param is omitted from the URL when it equals the smart default - clean URLs in default state, explicit override sticks. %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1.5 mt-1.5 border-t border-border/40">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-full sm:w-20 shrink-0">Granularity</span>
      <div class="flex flex-wrap items-center gap-1.5 flex-1 min-w-0">
        <% [[:day, "Day"], [:week, "Week"], [:month, "Month"]].each do |key, label| %>
          <% is_active = filter.bucket == key %>
          <% href = url_for(filter.to_query_params.merge(bucket: key)) %>
          <% cls = "rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors #{is_active ? active_chip_cls : inactive_chip_cls}" %>
          <%= link_to label, href, class: cls %>
        <% end %>
        <% unless filter.bucket_explicit? %>
          <span class="text-xs text-muted-foreground/70 ml-1">auto</span>
        <% end %>
      </div>
    </div>

    <% if filter.available_currencies.size > 1 %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1.5 mt-1.5 border-t border-border/40">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-full sm:w-20 shrink-0">Currency</span>
        <div class="flex flex-wrap items-center gap-1.5 flex-1 min-w-0">
          <% filter.available_currencies.each do |iso| %>
            <% is_active = filter.currency == iso %>
            <% href = url_for(filter.to_query_params.merge(currency: iso)) %>
            <% cls = "rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors #{is_active ? active_chip_cls : inactive_chip_cls}" %>
            <%= link_to iso, href, class: cls %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1.5 mt-1.5 border-t border-border/40">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-full sm:w-20 shrink-0">Accounts</span>
      <div class="flex flex-wrap items-center gap-2 flex-1 min-w-0">
        <% account_chip_links.each do |link| %>
          <% acc        = link[:account] %>
          <% bc         = acc.current_bank_connection %>
          <% bank_label = bc&.bank_name || bc&.bank_slug || (acc.cash_wallet? ? "Cash" : "Account") %>
          <% iban_prefix = acc.iban.to_s.delete(" ").first(4).presence %>
          <% currency   = acc.currency.presence %>
          <% chip_cls = "inline-flex items-center gap-2 rounded-full pl-1.5 pr-4 py-1.5 text-sm font-medium transition-colors #{link[:active] ? active_chip_cls : inactive_chip_cls} #{'opacity-60' unless link[:active]}" %>
          <%= link_to link[:href], class: chip_cls do %>
            <% if bc&.bank_slug %>
              <%= render "admin/shared/components/bank_logo", slug: bc.bank_slug, name: bc.bank_name, size: :sm %>
            <% else %>
              <%= render "admin/shared/components/bank_logo", slug: "_cash", name: bank_label, size: :sm %>
            <% end %>
            <span class="<%= sensitive_class %>">
              <%= bank_label %>
              <% if iban_prefix %>
                <span class="text-muted-foreground font-normal ml-1">· <%= iban_prefix %> ••••</span>
              <% elsif currency %>
                <span class="text-muted-foreground font-normal ml-1">· <%= currency %></span>
              <% end %>
              <% if bc %>
                <span class="font-normal ml-1 text-muted-foreground">· <%= sync_age_label(bc.last_synced_at) %></span>
              <% end %>
            </span>
          <% end %>
        <% end %>
        <% if active_count.positive? || filter.none? %>
          <%= link_to "Reset", url_for(filter.to_query_params.except(:account_ids, :accounts)),
                class: "ml-1 text-xs text-muted-foreground hover:text-foreground transition-colors" %>
        <% end %>
      </div>
    </div>

    <%= render "admin/shared/components/filter_panel",
          clear_url: url_for(filter.to_query_params.except(:account_ids, :accounts)),
          active_count: active_count do %>
      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Accounts</label>
        <div class="space-y-1 pt-1">
          <% user_accounts.each do |acc| %>
            <% bc          = acc.current_bank_connection %>
            <% bank_label  = bc&.bank_name || bc&.bank_slug || (acc.cash_wallet? ? "Cash" : "Account") %>
            <% iban_prefix = acc.iban.to_s.delete(" ").first(4).presence %>
            <% currency    = acc.currency.presence %>
            <label class="flex items-center gap-3 cursor-pointer hover:bg-muted/30 px-2 py-2 rounded-md">
              <%= check_box_tag "account_ids[]", acc.id, filter.account_ids.include?(acc.id),
                    id: "filter_account_#{acc.id}", class: "rounded border-border" %>
              <% if bc&.bank_slug %>
                <%= render "admin/shared/components/bank_logo", slug: bc.bank_slug, name: bc.bank_name, size: :sm %>
              <% else %>
                <%= render "admin/shared/components/bank_logo", slug: "_cash", name: bank_label, size: :sm %>
              <% end %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground truncate <%= sensitive_class %>">
                  <%= bank_label %>
                  <% if currency %><span class="text-xs text-muted-foreground font-normal ml-1">· <%= currency %></span><% end %>
                </p>
                <p class="text-xs text-muted-foreground truncate <%= sensitive_class %>">
                  <%= acc.display_name %><% if iban_prefix %> · <%= iban_prefix %> ••••<% end %>
                </p>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">From</label>
        <input type="date" name="from" value="<%= filter.period.from.iso8601 %>" class="form-input">
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">To</label>
        <input type="date" name="to" value="<%= filter.period.to.iso8601 %>" class="form-input">
      </div>
    <% end %>
  <% end %>
<% end %>
