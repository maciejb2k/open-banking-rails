<%# locals: (filter:, user_accounts:) %>
<%# Filter bar shared by every analytics page. Section-based layout
    (Period / Accounts) so additional chip groups (categories, tags …)
    can drop in as new sections later without redesigning the strip. %>

<%
  presets = [
    { label: "Today", days: 1   },
    { label: "3d",    days: 3   },
    { label: "7d",    days: 7   },
    { label: "14d",   days: 14  },
    { label: "30d",   days: 30  },
    { label: "60d",   days: 60  },
    { label: "90d",   days: 90  },
    { label: "365d",  days: 365 }
  ]
  active_preset_days = presets.find { |p| p[:days] == filter.period.length_days }&.dig(:days)

  # All-accounts toggle chips. Each chip carries its own URL; click
  # toggles its account in/out of the filter. Three target states:
  #   * collapse to default (all-owned, no params) when the resulting
  #     selection covers every owned account
  #   * `?accounts=none` when the user toggles the last chip off (true
  #     zero — charts show 0, distinct from default)
  #   * narrowed `?account_ids[]=…` everywhere else
  owned_ids   = current_user.all_bank_account_ids
  current_ids = filter.account_ids

  account_chip_links = user_accounts.map do |acc|
    is_active = current_ids.include?(acc.id)
    new_ids =
      if filter.all_accounts?
        owned_ids - [acc.id]
      elsif is_active
        current_ids - [acc.id]
      else
        current_ids + [acc.id]
      end

    base = filter.to_query_params.except(:account_ids, :accounts)
    href =
      if new_ids.sort == owned_ids.sort
        url_for(base)
      elsif new_ids.empty?
        url_for(base.merge(accounts: "none"))
      else
        url_for(base.merge(account_ids: new_ids))
      end

    { account: acc, active: is_active, href: href }
  end

  active_count = filter.all_accounts? ? 0 : filter.account_ids.size

  # Shared chip styles. "Active" uses a soft primary tint + ring instead
  # of a fully filled green pill — full-fill obliterates the bank logo
  # and label. Inactive is plain card with border.
  active_chip_cls   = "bg-primary/10 ring-1 ring-primary/40 text-foreground"
  inactive_chip_cls = "border border-border/70 bg-card text-muted-foreground hover:text-foreground hover:bg-muted/40"
%>

<%# Section pattern: row of `text-[10px] uppercase` label + flex-wrap chip area
    + optional aside. Used 2× below (Period / Accounts). If a 3rd section
    appears (Categories, Tags, …), extract `_filter_section` taking
    `label:` + block content for the chip area. %>
<%# Toggle-chip pattern: period chips and account chips share the same
    active/inactive style strings (`active_chip_cls` / `inactive_chip_cls`)
    but render different shapes. If a 3rd toggle-chip surfaces (e.g.
    category multiselect), extract `_toggle_chip` partial taking
    `active:`, `href:`, body block. %>
<div data-controller="filter-panel" class="space-y-3">
  <%= form_with url: url_for(only_path: true), method: :get, html: { data: { turbo: false } } do |f| %>

    <%# ── Period section ─────────────────────────────────────────────── %>
    <%# Period preset chips strip ?bucket so the smart default
        (day/week/month-by-length) re-resolves on length change. If user
        explicitly picks a bucket via the granularity chips below, that
        wins until they change period again. %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-20 shrink-0">Period</span>
      <div class="flex flex-wrap items-center gap-1.5 flex-1 min-w-0">
        <% presets.each do |preset| %>
          <% to = Date.current %>
          <% from = to - (preset[:days] - 1).days %>
          <% href = url_for(filter.to_query_params.except(:bucket).merge(from: from.iso8601, to: to.iso8601)) %>
          <% is_active = active_preset_days == preset[:days] %>
          <% cls = "rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors #{is_active ? active_chip_cls : inactive_chip_cls}" %>
          <%= link_to preset[:label], href, class: cls %>
        <% end %>
      </div>
      <span class="text-xs text-muted-foreground tabular-nums shrink-0">
        <%= filter.period.from.strftime("%-d %b") %> → <%= filter.period.to.strftime("%-d %b %Y") %>
      </span>
      <%= render "admin/shared/components/filter_trigger", active_count: active_count %>
    </div>

    <%# ── Granularity section ────────────────────────────────────────── %>
    <%# Day / Week / Month bucket switch for time-series widgets. Bucket
        param is omitted from the URL when it equals the smart default —
        clean URLs in default state, explicit override sticks. %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 border-t border-border/40">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-20 shrink-0">Granularity</span>
      <div class="flex flex-wrap items-center gap-1.5 flex-1 min-w-0">
        <% [[:day, "Day"], [:week, "Week"], [:month, "Month"]].each do |key, label| %>
          <% is_active = filter.bucket == key %>
          <% href = url_for(filter.to_query_params.merge(bucket: key)) %>
          <% cls = "rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors #{is_active ? active_chip_cls : inactive_chip_cls}" %>
          <%= link_to label, href, class: cls %>
        <% end %>
        <% unless filter.bucket_explicit? %>
          <span class="text-xs text-muted-foreground/70 ml-1">auto</span>
        <% end %>
      </div>
    </div>

    <%# ── Accounts section ───────────────────────────────────────────── %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 border-t border-border/40">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/80 w-20 shrink-0">Accounts</span>
      <div class="flex flex-wrap items-center gap-2 flex-1 min-w-0">
        <% account_chip_links.each do |link| %>
          <% acc        = link[:account] %>
          <% bc         = acc.current_bank_connection %>
          <% bank_label = bc&.bank_name || bc&.bank_slug || (acc.cash_wallet? ? "Cash" : "Account") %>
          <% iban_prefix = acc.iban.to_s.delete(" ").first(4).presence %>
          <% currency   = acc.currency.presence %>
          <% chip_cls = "inline-flex items-center gap-2 rounded-full pl-1.5 pr-4 py-1.5 text-sm font-medium transition-colors #{link[:active] ? active_chip_cls : inactive_chip_cls} #{'opacity-60' unless link[:active]}" %>
          <%= link_to link[:href], class: chip_cls do %>
            <% if bc&.bank_slug %>
              <%= render "admin/shared/components/bank_logo", slug: bc.bank_slug, name: bc.bank_name, size: :sm %>
            <% else %>
              <%= render "admin/shared/components/bank_logo", slug: "_cash", name: bank_label, size: :sm %>
            <% end %>
            <span class="<%= sensitive_class %>">
              <%= bank_label %>
              <% if iban_prefix %>
                <span class="text-muted-foreground font-normal ml-1">· <%= iban_prefix %> ••••</span>
              <% elsif currency %>
                <span class="text-muted-foreground font-normal ml-1">· <%= currency %></span>
              <% end %>
            </span>
          <% end %>
        <% end %>
        <% if active_count.positive? || filter.none? %>
          <%= link_to "Reset", url_for(filter.to_query_params.except(:account_ids, :accounts)),
                class: "ml-1 text-xs text-muted-foreground hover:text-foreground transition-colors" %>
        <% end %>
      </div>
    </div>

    <%# ── Slide-out panel: full-detail account list + custom date range %>
    <%= render "admin/shared/components/filter_panel",
          clear_url: url_for(filter.to_query_params.except(:account_ids, :accounts)),
          active_count: active_count do %>
      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Accounts</label>
        <div class="space-y-1 pt-1">
          <% user_accounts.each do |acc| %>
            <% bc          = acc.current_bank_connection %>
            <% bank_label  = bc&.bank_name || bc&.bank_slug || (acc.cash_wallet? ? "Cash" : "Account") %>
            <% iban_prefix = acc.iban.to_s.delete(" ").first(4).presence %>
            <% currency    = acc.currency.presence %>
            <label class="flex items-center gap-3 cursor-pointer hover:bg-muted/30 px-2 py-2 rounded-md">
              <%= check_box_tag "account_ids[]", acc.id, filter.account_ids.include?(acc.id),
                    id: "filter_account_#{acc.id}", class: "rounded border-border" %>
              <% if bc&.bank_slug %>
                <%= render "admin/shared/components/bank_logo", slug: bc.bank_slug, name: bc.bank_name, size: :sm %>
              <% else %>
                <%= render "admin/shared/components/bank_logo", slug: "_cash", name: bank_label, size: :sm %>
              <% end %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-foreground truncate <%= sensitive_class %>">
                  <%= bank_label %>
                  <% if currency %><span class="text-xs text-muted-foreground font-normal ml-1">· <%= currency %></span><% end %>
                </p>
                <p class="text-xs text-muted-foreground truncate <%= sensitive_class %>">
                  <%= acc.display_name %><% if iban_prefix %> · <%= iban_prefix %> ••••<% end %>
                </p>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">From</label>
        <input type="date" name="from" value="<%= filter.period.from.iso8601 %>" class="form-input">
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">To</label>
        <input type="date" name="to" value="<%= filter.period.to.iso8601 %>" class="form-input">
      </div>
    <% end %>
  <% end %>
</div>
