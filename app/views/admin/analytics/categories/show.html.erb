<%
  user_accounts = current_user.bank_accounts.to_a + current_user.cash_wallets.to_a
  total = Money.new(@total_cents, @filter.currency)

  row_struct = Struct.new(:label, :amount_cents, :count, :href, :secondary, keyword_init: true)

  # Two ways to drill: by child category (when descendants exist) and by
  # merchant. Both render via the same breakdown_list component, just
  # with different rows.
  subtree_rows = @subtree_rows.map do |row|
    next nil if row.amount_cents.zero?
    cat = current_user.categories.find_by(path: row.path)
    next nil unless cat
    next nil if current_user.hides_category?(cat)
    row_struct.new(
      label:        row.name,
      amount_cents: row.amount_cents,
      count:        row.count,
      href:         admin_analytics_category_path(cat.slug, @filter.to_query_params)
    )
  end.compact

  list_rows = @rows.map do |row|
    if row.merchant&.slug
      row_struct.new(
        label:        row.merchant.display,
        amount_cents: row.amount_cents,
        count:        row.count,
        href:         admin_analytics_merchant_path(row.merchant.slug, @filter.to_query_params)
      )
    else
      # Transactions classified into this category but without a merchant -
      # typical for one-off P2P payments, manual cash entries, or rules
      # that set only a category. Link drills into the underlying ledger
      # rows so the user can open and reclassify each one.
      row_struct.new(
        label:        "No merchant",
        amount_cents: row.amount_cents,
        count:        row.count,
        href:         admin_bank_transactions_path(
                        category_id:      @category.id,
                        enrichment_state: "merchantless",
                        q:                { booking_date_gteq: @filter.period.from.iso8601,
                                            booking_date_lteq: @filter.period.to.iso8601 }
                      )
      )
    end
  end
%>

<div class="space-y-6">
  <%= render "admin/shared/components/page_header",
        title: @category.name,
        subtitle: "Path: #{@category.path}. #{pluralize(@filter.period.length_days, 'day')} window." %>

  <%= render "admin/analytics/shared/filter_strip", filter: @filter, user_accounts: user_accounts %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <%= render "admin/shared/components/stat_card",
          label: "Total in subtree",
          value: total.format(no_cents_if_whole: true),
          icon:  "shopping_cart",
          tone:  :destructive,
          value_class: sensitive_class %>
    <%= render "admin/shared/components/stat_card",
          label: "Sub-categories",
          value: @subtree_rows.size.to_s,
          icon:  "tag",
          tone:  :info %>
    <%= render "admin/shared/components/stat_card",
          label: "Merchants (this leaf)",
          value: @rows.size.to_s,
          icon:  "tag",
          tone:  :warning %>
  </div>

  <% if subtree_rows.any? %>
    <%= render "admin/shared/components/card",
          title: "Sub-categories",
          subtitle: "Click to drill into a branch." do %>
      <%= render "admin/shared/components/breakdown_list",
            rows: subtree_rows,
            total_cents: subtree_rows.sum(&:amount_cents),
            currency: @filter.currency,
            empty_label: "No spend in any sub-category." %>
    <% end %>
  <% end %>

  <%= render "admin/shared/components/card",
        title: subtree_rows.any? ? "Merchants in entire subtree" : "Merchants",
        subtitle: subtree_rows.any? ? "Aggregated across all descendants." : nil do %>
    <%= render "admin/shared/components/breakdown_list",
          rows: list_rows,
          total_cents: @total_cents,
          currency: @filter.currency,
          empty_label: "No transactions in this subtree in the selected period." %>
  <% end %>
</div>
