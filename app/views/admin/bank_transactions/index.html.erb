<% sync_button = capture do %>
  <%= render "admin/shared/components/button",
        label: "Sync now",
        href: new_admin_transaction_sync_path,
        icon: "plus",
        variant: :outline %>
<% end %>

<div class="space-y-6" data-controller="filter-panel">
  <%= render "admin/shared/components/page_header",
        title: "Bank Transactions",
        subtitle: "All transactions pulled from Enable Banking, normalized across PKO / Revolut / mBank quirks.",
        actions: sync_button %>

  <% active_filter_count = [
       params.dig(:q, :bank_account_id_eq).present?,
       params.dig(:q, :direction_eq).present?,
       params.dig(:q, :status_eq).present?,
       params.dig(:q, :currency_eq).present?,
       params.dig(:q, :booking_date_gteq).present?,
       params.dig(:q, :booking_date_lteq).present?,
       params.dig(:q, :title_or_counterparty_name_or_enrichment_merchant_name_cont).present?,
       params[:merchant_id].present?,
       params[:category_id].present?,
       params[:payment_method].present?,
       params[:enrichment_source].present?,
       params[:enrichment_state].present?
     ].count(true) %>

  <%= search_form_for @q, url: admin_bank_transactions_path, html: { data: { turbo: false } } do |f| %>
    <%= f.hidden_field :s, value: params.dig(:q, :s) %>
    <%# Enrichment filters live outside the q[] Ransack hash — propagate them
        as plain hidden fields so submitting the form keeps them. %>
    <%= hidden_field_tag :merchant_id,        params[:merchant_id],        id: "ef_merchant_id" %>
    <%= hidden_field_tag :category_id,        params[:category_id],        id: "ef_category_id" %>
    <%= hidden_field_tag :payment_method,     params[:payment_method],     id: "ef_payment_method" %>
    <%= hidden_field_tag :enrichment_source,  params[:enrichment_source],  id: "ef_enrichment_source" %>
    <%= hidden_field_tag :enrichment_state,   params[:enrichment_state],   id: "ef_enrichment_state" %>

    <%# Search bar + filter trigger — full-width search on mobile so the
        placeholder isn't truncated; trigger + apply wrap below if needed. %>
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <div class="relative w-full sm:w-auto sm:flex-1 sm:max-w-md">
        <%= render "admin/shared/icons/search", classes: "absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" %>
        <%= f.search_field :title_or_counterparty_name_or_enrichment_merchant_name_cont,
              placeholder: "Search title, counterparty or merchant…",
              class: "w-full rounded-lg border bg-card pl-9 pr-4 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition" %>
      </div>

      <%= render "admin/shared/components/filter_trigger", active_count: active_filter_count %>

      <%= render "admin/shared/components/button", label: "Apply", type: :submit %>
    </div>

    <%# Active filter chips. label: keyword for plain strings; block for chips
        that need sensitive_class wrapping (Account, Search). Both renderings
        are deterministic after the filter_chip detection fix. %>
    <% if active_filter_count > 0 %>
      <div class="flex flex-wrap items-center gap-2 mt-3">
        <% if (val = params.dig(:q, :bank_account_id_eq)).present? %>
          <% acc = @user_bank_accounts.find { |a| a.id.to_s == val.to_s } %>
          <%= render "admin/shared/components/filter_chip",
                remove_path: admin_bank_transactions_path(q: params[:q].to_unsafe_h.except("bank_account_id_eq")) do %>
            Account: <span class="<%= sensitive_class %>"><%= acc&.display_name || "##{val}" %></span>
          <% end %>
        <% end %>
        <% if (val = params.dig(:q, :direction_eq)).present? %>
          <%= render "admin/shared/components/filter_chip",
                label: "Direction: #{val.capitalize}",
                remove_path: admin_bank_transactions_path(q: params[:q].to_unsafe_h.except("direction_eq")) %>
        <% end %>
        <% if (val = params.dig(:q, :status_eq)).present? %>
          <%= render "admin/shared/components/filter_chip",
                label: "Status: #{val.capitalize}",
                remove_path: admin_bank_transactions_path(q: params[:q].to_unsafe_h.except("status_eq")) %>
        <% end %>
        <% if (val = params.dig(:q, :currency_eq)).present? %>
          <%= render "admin/shared/components/filter_chip",
                label: "Currency: #{val}",
                remove_path: admin_bank_transactions_path(q: params[:q].to_unsafe_h.except("currency_eq")) %>
        <% end %>
        <% if params.dig(:q, :booking_date_gteq).present? || params.dig(:q, :booking_date_lteq).present? %>
          <%= render "admin/shared/components/filter_chip",
                label: "Date: #{params.dig(:q, :booking_date_gteq).presence || "…"} → #{params.dig(:q, :booking_date_lteq).presence || "…"}",
                remove_path: admin_bank_transactions_path(q: params[:q].to_unsafe_h.except("booking_date_gteq", "booking_date_lteq")) %>
        <% end %>
        <% if (val = params.dig(:q, :title_or_counterparty_name_or_enrichment_merchant_name_cont)).present? %>
          <%= render "admin/shared/components/filter_chip",
                remove_path: admin_bank_transactions_path(q: params[:q].to_unsafe_h.except("title_or_counterparty_name_or_enrichment_merchant_name_cont")) do %>
            Search: "<span class="<%= sensitive_class %>"><%= val %></span>"
          <% end %>
        <% end %>
        <% if (val = params[:merchant_id]).present? %>
          <% m = current_user.merchants.find_by(id: val) %>
          <% m_label = m ? hide_private_text(m.display, m.default_category_id) : "##{val}" %>
          <%= render "admin/shared/components/filter_chip",
                label: "Merchant: #{m_label}",
                remove_path: admin_bank_transactions_path(request.query_parameters.except("merchant_id")) %>
        <% end %>
        <% if (val = params[:category_id]).present? %>
          <% c = current_user.categories.find_by(id: val) %>
          <% c_label = c ? hide_private_text(c.name, c) : "##{val}" %>
          <%= render "admin/shared/components/filter_chip",
                label: "Category: #{c_label}",
                remove_path: admin_bank_transactions_path(request.query_parameters.except("category_id")) %>
        <% end %>
        <% if (val = params[:payment_method]).present? %>
          <%= render "admin/shared/components/filter_chip",
                label: "Method: #{payment_method_label(val)}",
                remove_path: admin_bank_transactions_path(request.query_parameters.except("payment_method")) %>
        <% end %>
        <% if (val = params[:enrichment_source]).present? %>
          <%= render "admin/shared/components/filter_chip",
                label: "Source: #{enrichment_source_label(val)}",
                remove_path: admin_bank_transactions_path(request.query_parameters.except("enrichment_source")) %>
        <% end %>
        <% if (val = params[:enrichment_state]).present? %>
          <% state_label = { "merchantless" => "Without a merchant", "llm_ready" => "LLM-ready", "no_llm_signal" => "LLM can't help" }[val] || val %>
          <%= render "admin/shared/components/filter_chip",
                label: "State: #{state_label}",
                remove_path: admin_bank_transactions_path(request.query_parameters.except("enrichment_state")) %>
        <% end %>
        <%= link_to "Clear all", admin_bank_transactions_path,
              class: "text-xs text-muted-foreground hover:text-foreground transition-colors" %>
      </div>
    <% end %>

    <%= render "admin/shared/components/filter_panel",
          clear_url: admin_bank_transactions_path,
          active_count: active_filter_count do %>
      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Bank account</label>
        <%# Native <option> text cannot be blurred by privacy mode (browsers ignore CSS %>
        <%# on option content). If this becomes an issue, swap for searchable_select. %>
        <%= f.select :bank_account_id_eq,
              [["All accounts", ""]] + @user_bank_accounts.map { |a|
                bank = a.current_bank_connection&.bank_name || a.current_bank_connection&.bank_slug
                ["#{bank.present? ? "#{bank} — " : ""}#{a.display_name}", a.id]
              },
              { selected: params.dig(:q, :bank_account_id_eq) },
              class: "form-input" %>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Direction</label>
        <%= f.select :direction_eq,
              [["All", ""], ["Credit (incoming)", "credit"], ["Debit (outgoing)", "debit"]],
              { selected: params.dig(:q, :direction_eq) },
              class: "form-input" %>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Status</label>
        <%= f.select :status_eq,
              [["All", ""], ["Booked", "booked"], ["Pending", "pending"]],
              { selected: params.dig(:q, :status_eq) },
              class: "form-input" %>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Currency</label>
        <% currencies = @user_bank_accounts.pluck(:currency).compact.uniq.sort %>
        <%= f.select :currency_eq,
              [["All", ""]] + currencies.map { |c| [c, c] },
              { selected: params.dig(:q, :currency_eq) },
              class: "form-input" %>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Booking date — from</label>
        <%= f.date_field :booking_date_gteq, value: params.dig(:q, :booking_date_gteq),
              class: "form-input" %>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Booking date — to</label>
        <%= f.date_field :booking_date_lteq, value: params.dig(:q, :booking_date_lteq),
              class: "form-input" %>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Merchant</label>
        <%# Plain HTML select bound to the hidden field outside @q via JS.
            Updates the mirror field on change so Apply submits both. %>
        <select onchange="document.getElementById('ef_merchant_id').value = this.value"
                class="form-input">
          <option value="">All merchants</option>
          <% current_user.merchants.active.order(:name).each do |m| %>
            <option value="<%= m.id %>" <%= 'selected' if params[:merchant_id].to_s == m.id.to_s %>><%= m.display %></option>
          <% end %>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Category</label>
        <select onchange="document.getElementById('ef_category_id').value = this.value"
                class="form-input">
          <option value="">All categories</option>
          <% current_user.categories.active.ordered.each do |c| %>
            <option value="<%= c.id %>" <%= 'selected' if params[:category_id].to_s == c.id.to_s %>>
              <%= c.breadcrumb_names.join(" / ") %>
            </option>
          <% end %>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Payment method</label>
        <select onchange="document.getElementById('ef_payment_method').value = this.value"
                class="form-input">
          <% payment_method_options.each do |label, value| %>
            <option value="<%= value %>" <%= 'selected' if params[:payment_method].to_s == value.to_s %>><%= label %></option>
          <% end %>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Classification source</label>
        <select onchange="document.getElementById('ef_enrichment_source').value = this.value"
                class="form-input">
          <option value="">All</option>
          <% TransactionEnrichment::SOURCES.each do |s| %>
            <option value="<%= s %>" <%= 'selected' if params[:enrichment_source].to_s == s %>><%= enrichment_source_label(s) %></option>
          <% end %>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Enrichment status</label>
        <%# Mirrors the "What's left" panel on /admin/llm_enrichments. The
            filter logic lives in BankTransactionsController#filter_by_enrichment_state. %>
        <select onchange="document.getElementById('ef_enrichment_state').value = this.value"
                class="form-input">
          <option value="">All</option>
          <option value="merchantless"  <%= 'selected' if params[:enrichment_state] == 'merchantless' %>>Without a merchant</option>
          <option value="llm_ready"     <%= 'selected' if params[:enrichment_state] == 'llm_ready' %>>LLM-ready (has signal)</option>
          <option value="no_llm_signal" <%= 'selected' if params[:enrichment_state] == 'no_llm_signal' %>>LLM can't help</option>
        </select>
      </div>
    <% end %>
  <% end %>

  <div class="admin-section p-0 overflow-hidden">
    <%= render "admin/shared/components/data_table",
          columns: [
            { label: "Date", sortable: "booking_date" },
            { label: "Account" },
            { label: "Merchant / Title" },
            { label: "Category" },
            { label: "Method" },
            { label: "Status", sortable: "status" },
            { label: "Amount", sortable: "amount_cents", align: :right },
            { label: "", width: "w-12" }
          ] do %>
      <% if @collection.empty? %>
        <tr>
          <td colspan="8">
            <%= render "admin/shared/components/empty_state",
                  title: "No transactions",
                  description: active_filter_count > 0 ? "No transactions match your filters." : "Run a sync above to pull data from your banks.",
                  icon: "dollar_sign" %>
          </td>
        </tr>
      <% else %>
        <% @collection.each do |tx| %>
          <% cat = tx.effective_category %>
          <% hidden = hide_private?(cat) %>
          <tr class="border-b last:border-0 hover:bg-muted/20 transition-colors">
            <td class="px-4 py-3 font-mono text-xs whitespace-nowrap"><%= tx.booking_date %></td>
            <td class="px-4 py-3 text-xs text-muted-foreground">
              <% bc = tx.bank_account.current_bank_connection %>
              <% bank = bc&.bank_name || bc&.bank_slug %>
              <div class="flex items-center gap-2">
                <% if bc %>
                  <%= render "admin/shared/components/bank_logo",
                        slug: bc.bank_slug, name: bc.bank_name, size: :sm %>
                <% end %>
                <div class="min-w-0">
                  <div class="text-foreground truncate"><%= bank %></div>
                  <div class="font-mono text-muted-foreground/70 truncate <%= sensitive_class %>"><%= tx.bank_account.iban || tx.bank_account.uid %></div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 max-w-xs">
              <% if tx.merchant %>
                <div class="flex items-center gap-2 min-w-0">
                  <span class="font-medium truncate <%= sensitive_class unless hidden %>"><%= hide_private_text(tx.merchant.display, cat) %></span>
                  <%= enrichment_source_badge(tx.enrichment&.source) %>
                </div>
                <% if tx.title.present? %>
                  <div class="text-xs text-muted-foreground truncate <%= sensitive_class unless hidden %>"><%= hide_private_text(tx.title, cat) %></div>
                <% end %>
              <% else %>
                <div class="flex items-center gap-2 min-w-0">
                  <span class="truncate <%= sensitive_class if tx.title.present? && !hidden %>"><%= hide_private_text(tx.title.presence || "—", cat) %></span>
                  <%= enrichment_source_badge(tx.enrichment&.source || "unmatched") %>
                </div>
                <% if tx.counterparty_name.present? %>
                  <div class="text-xs text-muted-foreground truncate <%= sensitive_class unless hidden %>"><%= hide_private_text(tx.counterparty_name, cat) %></div>
                <% end %>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs">
              <% if cat %>
                <%= render "admin/shared/components/category_breadcrumb", category: cat %>
              <% else %>
                <%# No category at all = enrichment.source = "unmatched" or
                    no enrichment row yet. Surface as a warning badge so
                    the user knows it's actionable, not "intentionally blank". %>
                <%= render "admin/shared/components/badge", text: "unclassified", variant: :warning %>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-muted-foreground whitespace-nowrap">
              <%= payment_method_label(tx.payment_method) || "—" %>
            </td>
            <td class="px-4 py-3">
              <%= render "admin/shared/components/badge",
                    text: tx.status,
                    variant: tx.status == "booked" ? :success : :info %>
            </td>
            <td class="px-4 py-3 text-right amount whitespace-nowrap <%= tx.direction == 'credit' ? 'text-success' : 'text-foreground' %>">
              <% if hidden %>
                <span>•••</span>
              <% else %>
                <span class="<%= sensitive_class %>"><%= tx.direction == "credit" ? "+" : "−" %><%= tx.amount.format(symbol: false, no_cents_if_whole: false) %></span>
                <span class="text-muted-foreground text-xs font-normal"><%= tx.currency %></span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <%= render "admin/shared/components/dropdown_menu", items: [
                { label: "View", icon: "eye", href: admin_bank_transaction_path(tx) }
              ] %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>

    <%= render "admin/shared/components/pagination", pagy: @pagy %>
  </div>
</div>
