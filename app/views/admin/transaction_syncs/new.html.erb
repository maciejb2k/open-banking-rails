<div class="space-y-6">
  <%= render "admin/shared/components/page_header",
        title: "New sync",
        subtitle: "Pulls transactions from Enable Banking in the background. You'll be redirected to the sync page where progress streams live." %>

  <%= form_with url: admin_transaction_syncs_path, method: :post, local: true, class: "space-y-6" do |f| %>
    <%= render "admin/shared/components/card", title: "Scope" do %>
      <p class="text-sm text-muted-foreground -mt-2 mb-4">
        Pick a single bank connection or sync everything you've authorized.
        Per-bank silent truncation applies: <code>Revolut 90d</code>,
        <code>PKO ~26mo</code>, <code>mBank ~90d</code>.
      </p>

      <%= render "admin/shared/form/form_group", label: "Bank connection", hint: "Leave empty to sync all your active connections" do %>
        <%= f.select :bank_connection_id,
              [["All my connections", ""]] + @user_bank_connections.map { |bc|
                ["#{bc.bank_name.presence || bc.bank_slug} (#{bc.bank_country})", bc.id]
              },
              {},
              class: "form-input" %>
      <% end %>
    <% end %>

    <%= render "admin/shared/components/card", title: "Date range" do %>
      <p class="text-sm text-muted-foreground -mt-2 mb-4">
        Both optional. If left empty, the operation defaults to the bank's max
        horizon for first-time accounts, otherwise <code>last_synced − 7d</code>
        (incremental with overlap to catch late-bookings).
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= render "admin/shared/form/form_group", label: "From" do %>
          <%= f.date_field :date_from, value: @sync_default_from,
                class: "form-input" %>
        <% end %>
        <%= render "admin/shared/form/form_group", label: "To" do %>
          <%= f.date_field :date_to, value: @sync_default_to,
                class: "form-input" %>
        <% end %>
      </div>
    <% end %>

    <div class="flex items-center justify-end gap-3">
      <%= render "admin/shared/components/button",
            label: "Cancel",
            href: admin_transaction_syncs_path,
            variant: :outline %>
      <%= render "admin/shared/components/button",
            label: "Start sync",
            type: :submit %>
    </div>
  <% end %>
</div>
