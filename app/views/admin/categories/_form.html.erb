<%# locals: (category:) %>
<%
  # Exclude self + descendants from parent options to prevent cycles.
  forbidden_ids = category.persisted? ? category.self_and_descendants.pluck(:id) : []
  parent_options = current_user.categories.active.where.not(id: forbidden_ids).ordered.map do |c|
    next if current_user.hides_category?(c)
    indent = "-" * c.path.to_s.count(".")
    [ "#{indent} #{c.breadcrumb_names.join(" / ")}".strip, c.path.to_s ]
  end.compact
%>
<%= form_with model: category, url: category.persisted? ? admin_category_path(category) : admin_categories_path, html: { class: "space-y-6" } do |f| %>
  <%= render "admin/shared/form/error_summary", object: category %>

  <div class="admin-section max-w-2xl space-y-5">
    <%= render "admin/shared/form/text_field",
          form: f, field: :name,
          label: "Name",
          placeholder: "e.g. Restaurants",
          required: true %>

    <%= render "admin/shared/form/text_field",
          form: f, field: :slug,
          label: "Slug",
          hint: "Stable identifier; auto-generated from the path. Don't change it once rules or exports rely on it.",
          placeholder: "lifestyle_shopping_electronics" %>

    <%# Custom: ltree parent-path picker. Controller composes "<parent_path>.<leaf>" before save. If a 2nd path-typed picker appears, extract _path_select. %>
    <div>
      <%= f.label :parent_path, "Parent path", class: "block text-sm font-medium mb-1" %>
      <%= f.select :parent_path,
            options_for_select(parent_options, params[:parent_path] || category.path.to_s.split(".")[0..-2].join(".")),
            { include_blank: "- top-level (new root) -" },
            class: "form-input" %>
      <p class="text-xs text-muted-foreground mt-1">Empty = new top-level domain. Otherwise the new category becomes a child of the selected path.</p>
    </div>

    <%= render "admin/shared/form/select",
          form: f, field: :kind,
          label: "Kind",
          options: Category::KINDS.map { |k| [ k.humanize, k ] },
          hint: "expense counts toward spending. transfer / ignored are excluded from analytics totals." %>

    <%= render "admin/shared/form/checkbox",
          form: f, field: :essential,
          label: "Essential (need)",
          hint: "Counts toward the essentials KPI. Defaults to off - flip on for needs (rent, utilities, groceries, transit)." %>

    <%= render "admin/shared/form/text_field",
          form: f, field: :color,
          label: "Color (token)",
          placeholder: "emerald, blue, rose..." %>

    <%= render "admin/shared/form/text_field",
          form: f, field: :icon,
          label: "Icon (file name from shared/icons/)",
          placeholder: "shopping-cart" %>

    <%= render "admin/shared/form/number_field",
          form: f, field: :position,
          label: "Position",
          hint: "Lower = higher on the list within its level." %>
  </div>

  <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-end gap-2 sm:gap-3">
    <%= render "admin/shared/components/button", label: "Cancel", href: admin_categories_path, variant: :outline %>
    <%= render "admin/shared/components/button", label: category.persisted? ? "Save changes" : "Create category", type: :submit %>
  </div>
<% end %>
