<% page_actions = capture do %>
  <%= render "admin/shared/components/button",
        label: "New category",
        href: new_admin_category_path,
        icon: "plus",
        variant: :default %>
<% end %>

<div class="space-y-6">
  <%= render "admin/shared/components/page_header",
        title: "Categories",
        subtitle: "Tree of expense / income / transfer / savings buckets. Sub-categories indent under their parent - depth is unbounded. Renaming doesn't change slugs.",
        actions: page_actions %>

  <div class="admin-section p-0 overflow-hidden">
    <%= render "admin/shared/components/data_table",
          columns: [
            { label: "Name" },
            { label: "Path" },
            { label: "Kind" },
            { label: "Essential" },
            { label: "", width: "w-12" }
          ] do %>
      <% if @categories.empty? %>
        <tr>
          <td colspan="5">
            <%= render "admin/shared/components/empty_state",
                  title: "No categories",
                  description: "Add your first category to get started.",
                  action_label: "New category",
                  action_path: new_admin_category_path,
                  icon: "shopping_cart" %>
          </td>
        </tr>
      <% else %>
        <% @categories.each do |c| %>
          <%
            depth = c.path.to_s.count(".")
            row_classes = depth.zero? ? "bg-muted/10" : ""
            # Tighter step (16px) so deeply-nested trees stay readable on
            # narrow viewports without horizontal scrolling.
            indent_px = 12 + depth * 16
            label_class = depth.zero? ? "font-semibold text-foreground" : "text-sm text-foreground/90"
          %>
          <tr class="border-b last:border-0 hover:bg-muted/20 transition-colors <%= row_classes %>">
            <td class="py-2.5 pr-3 sm:pr-4 <%= label_class %>" style="padding-left: <%= indent_px %>px;">
              <% if depth.positive? %>
                <span class="text-muted-foreground/60 mr-2">└</span>
              <% end %>
              <%= hide_private_text(c.name, c) %>
            </td>
            <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground"><%= hide_private_text(c.path.to_s, c) %></td>
            <td class="px-4 py-2.5">
              <%= render "admin/shared/components/badge", text: c.kind, variant: c.kind == "expense" ? :default : :muted %>
            </td>
            <td class="px-4 py-2.5 text-xs">
              <% if c.essential %>
                <%= render "admin/shared/components/badge", text: "essential", variant: :info %>
              <% end %>
            </td>
            <td class="px-4 py-2.5">
              <%= render "admin/shared/components/dropdown_menu", items: [
                    { label: "Edit", icon: "pencil", href: edit_admin_category_path(c) },
                    { label: "Add sub-category", icon: "plus", href: new_admin_category_path(parent_path: c.path.to_s) },
                    { divider: true },
                    { label: "Archive", icon: "eye_off", method: :post, href: archive_admin_category_path(c), variant: :destructive }
                  ] %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @archived.any? %>
    <%= render "admin/shared/components/card", title: "Archived", subtitle: "Hidden from forms; historical links are preserved." do %>
      <ul class="divide-y -mx-4">
        <% @archived.each do |c| %>
          <li class="flex items-center justify-between px-4 py-2.5">
            <div class="min-w-0">
              <span class="text-sm text-muted-foreground">
                <%= render "admin/shared/components/category_breadcrumb", category: c %>
              </span>
            </div>
            <%= render "admin/shared/components/button",
                  label: "Restore",
                  href: unarchive_admin_category_path(c),
                  method: :post,
                  variant: :outline,
                  size: :sm %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
