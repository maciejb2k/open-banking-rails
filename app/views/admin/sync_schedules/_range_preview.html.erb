<%# locals: (connection:) %>
<%# Read-only projection - actual sync behavior lives in EnableBanking::Operations::SyncAccountTransactions. %>
<%
  overlap_days = EnableBanking::Operations::SyncAccountTransactions::INCREMENTAL_OVERLAP / 1.day
  bank_horizon_days = EnableBanking::BackfillWindow.days_for(connection.bank_slug)
  today = Date.current

  rows = connection.current_bank_accounts.map do |account|
    if account.transactions_synced_at.present?
      from = (account.transactions_synced_at - overlap_days.days).to_date
      { account: account, from: from, to: today, days: (today - from).to_i, kind: :incremental }
    else
      from = today - bank_horizon_days
      { account: account, from: from, to: today, days: bank_horizon_days, kind: :first_sync }
    end
  end
%>

<div class="admin-section space-y-3">
  <div>
    <h2 class="text-base font-semibold text-foreground">What each scheduled run pulls</h2>
    <p class="text-sm text-muted-foreground">
      Auto-sync is incremental: it pulls everything since the last successful sync, plus a <%= overlap_days %>-day
      safety overlap (catches late-bookings the bank back-dated).
    </p>
  </div>

  <% if rows.empty? %>
    <p class="text-sm text-muted-foreground">No active accounts on this connection.</p>
  <% else %>
    <ul class="divide-y rounded-lg border bg-card text-sm">
      <% rows.each do |row| %>
        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5">
          <div class="min-w-0">
            <p class="font-mono text-xs text-foreground <%= sensitive_class %>"><%= row[:account].iban || row[:account].uid %></p>
            <p class="text-xs text-muted-foreground mt-0.5">
              <% if row[:kind] == :first_sync %>
                <%= render "admin/shared/components/badge", text: "First sync", variant: :info %>
                No prior sync recorded.
              <% else %>
                Last synced <%= l(row[:account].transactions_synced_at, format: :short) %>.
              <% end %>
            </p>
          </div>
          <div class="text-right text-xs">
            <p class="text-foreground font-medium tabular-nums">
              <%= row[:from] %> &rarr; <%= row[:to] %>
            </p>
            <p class="text-muted-foreground">~<%= row[:days] %> days</p>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
