<%# locals: (connection:, schedule:) %>
<%= form_with model: schedule,
              url: admin_bank_connection_sync_schedule_path(connection),
              method: :patch,
              scope: :sync_schedule,
              class: "space-y-6",
              local: true do |f| %>
  <%= render "admin/shared/form/error_summary", object: schedule %>

  <div class="admin-section space-y-4">
    <h2 class="text-base font-semibold text-foreground">Schedule</h2>

    <%= render "admin/shared/form/checkbox",
          form: f, field: :enabled,
          label: "Enable auto-sync for this connection",
          hint: "Off by default. Turning on starts the schedule from the next slot." %>

    <%= render "admin/shared/form/select",
          form: f, field: :cadence, label: "Cadence", required: true,
          options: SyncSchedule::CADENCES.map { |c| [c.humanize, c] },
          hint: "Daily fires once a day, every 2 days every 48h, weekly every 7 days - all anchored to the hour below." %>

    <%= render "admin/shared/form/select",
          form: f, field: :preferred_hour, label: "Preferred hour", required: true,
          options: (0..23).map { |h| ["%02d:00" % h, h] },
          hint: "Local time. Actual fire time is offset by up to ~5 minutes (jitter) to spread load on the bank API." %>
  </div>

  <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-end gap-2 sm:gap-3">
    <%= render "admin/shared/components/button",
          label: "Cancel",
          href: admin_transaction_syncs_path,
          variant: :outline %>
    <%= render "admin/shared/components/button",
          label: "Save settings",
          type: :submit %>
  </div>
<% end %>
