<% content_for :title, "Set new password" %>

<div class="mb-6">
  <h1 class="text-xl font-semibold text-foreground">Set a new password</h1>
  <p class="mt-1 text-sm text-muted-foreground">Choose a strong password you haven't used before.</p>
</div>

<%= form_with model: resource, url: password_path(resource_name), method: :put, html: { class: "space-y-5" } do |f| %>
  <%= render "admin/shared/form/error_summary", object: resource %>
  <%= f.hidden_field :reset_password_token %>

  <%= render "admin/shared/form/password_field",
        form: f, field: :password,
        label: "New password",
        required: true,
        hint: (resource.class.password_length ? "Minimum #{resource.class.password_length.min} characters." : nil),
        html: { autofocus: true, autocomplete: "new-password" } %>

  <%= render "admin/shared/form/password_field",
        form: f, field: :password_confirmation,
        label: "Confirm new password",
        required: true,
        html: { autocomplete: "new-password" } %>

  <%= f.submit "Update password",
        class: "inline-flex w-full items-center justify-center gap-2 rounded-lg font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-6 py-2.5 text-sm cursor-pointer" %>
<% end %>

<div class="mt-6 border-t border-border pt-4 text-center text-sm">
  <%= link_to "Back to sign in",
        new_session_path(resource_name),
        class: "font-medium text-primary hover:text-primary/80 transition-colors" %>
</div>
