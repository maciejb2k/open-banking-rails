<!DOCTYPE html>
<html lang="en" class="<%= 'privacy-mode' if privacy_mode? %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for(:title).presence || "Open Banking Admin" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg?v=3" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="sensitive-mask">
    <div class="flex h-screen overflow-hidden bg-background"
         data-controller="sidebar">

      <div data-sidebar-target="overlay"
           class="fixed inset-0 z-40 bg-foreground/50 lg:hidden hidden"
           data-action="click->sidebar#closeMobile"></div>

      <%= render "admin/shared/sidebar" %>

      <div class="flex flex-1 flex-col overflow-hidden min-w-0">
        <%= render "admin/shared/topbar" %>
        <%# `scrollbar-gutter: stable` reserves the scrollbar track even when
            content fits — pages don't shift horizontally when navigating
            from a long page to a short one. Browsers without support fall
            back to overflow-y-auto's default behavior gracefully. %>
        <main class="flex-1 overflow-y-auto overflow-x-hidden p-4 lg:p-6 [scrollbar-gutter:stable]">
          <div class="mx-auto w-full max-w-[1400px]">
            <%= render "admin/shared/flash" %>
            <%= render "admin/shared/setup_banner" if user_signed_in? %>
            <%= yield %>
          </div>
          <%= render "admin/shared/footer" %>
        </main>
      </div>

      <%= render "admin/shared/components/command_palette" %>
    </div>
  </body>
</html>
