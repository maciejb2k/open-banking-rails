POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open_banking_rails_development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

OTEL_SERVICE_NAME=open-banking-rails
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# ActiveRecord encryption (generate via `bin/rails db:encryption:init`)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# OpenAI API — default provider. gpt-4o-mini is cheapest with structured output.
# Generate at https://platform.openai.com/api-keys
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MERCHANT_AUTO_APPROVE_THRESHOLD=0.85

# Gemini API (optional fallback — Google AI Studio).
GEMINI_API_KEY=
